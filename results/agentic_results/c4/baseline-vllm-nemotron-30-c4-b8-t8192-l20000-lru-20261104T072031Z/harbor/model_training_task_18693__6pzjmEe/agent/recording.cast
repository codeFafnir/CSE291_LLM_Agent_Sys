[377.739248, "o", "\u001b[?2004h> "]
[377.739555, "o", "train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True)\r\n\u001b[?2004l\r"]
[377.739717, "o", "\u001b[?2004h> "]
[377.739779, "o", "\" >> train.py\r\n\u001b[?2004l\r"]
[377.739999, "o", "\u001b[?2004h(venv) root@e89999b179b9:/app# "]
[377.839128, "i", "echo \"# Define neural network model\nclass Net(nn.Module):\n    def __init__(self):\n        super(Net, self).__init__()\n        self.fc1 = nn.Linear(20, 128)\n        self.dropout1 = nn.Dropout(0.3)\n        self.fc2 = nn.Linear(128, 64)\n        self.dropout2 = nn.Dropout(0.3)\n        self.fc3 = nn.Linear(64, 1)\n\n    def forward(self, x):\n        x = torch.relu(self.fc1(x))\n        x = self.dropout1(x)\n        x = torch.relu(self.fc2(x))\n        x = self.dropout2(x)\n        x = self.fc3(x)\n        return x\n\" >> train.py\n"]
[377.839382, "o", "echo \"# Define neural network model\r\n\u001b[?2004l\r"]
[377.839443, "o", "\u001b[?2004h> "]
