[377.73851, "i", "echo \"# Create DataLoader\ntrain_dataset = TensorDataset(X_train_tensor, y_train_tensor)\ntrain_loader = DataLoader(train_dataset, batch_size=16, shuffle=True)\n\" >> train.py\n"]
