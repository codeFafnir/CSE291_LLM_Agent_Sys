[377.841107, "o", "        self.fc3 = nn.Linear(64, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[377.841196, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[377.841337, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[377.841514, "o", "        x = torch.relu(self.fc1(x))\r\n\u001b[?2004l\r\u001b[?2004h"]
[377.841567, "o", "> "]
[377.841677, "o", "        x = self.dropout1(x)\r\n\u001b[?2004l\r"]
[377.841727, "o", "\u001b[?2004h> "]
[377.841862, "o", "        x = torch.relu(self.fc2(x))\r\n\u001b[?2004l\r"]
