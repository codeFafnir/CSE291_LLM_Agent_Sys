[378.454691, "o", "            'train_loss': train_loss,\r\n\u001b[?2004l\r\u001b[?2004h"]
[378.454743, "o", "> "]
[378.454872, "o", "            'val_loss': val_loss,\r\n\u001b[?2004l\r\u001b[?2004h"]
[378.454953, "o", "> "]
[378.455076, "o", "            'val_accuracy': val_accuracy\r\n\u001b[?2004l\r"]
[378.455127, "o", "\u001b[?2004h> "]
[378.455245, "o", "        }, checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[378.455302, "o", "> \r\n\u001b[?2004l\r"]
[378.455351, "o", "\u001b[?2004h> "]
