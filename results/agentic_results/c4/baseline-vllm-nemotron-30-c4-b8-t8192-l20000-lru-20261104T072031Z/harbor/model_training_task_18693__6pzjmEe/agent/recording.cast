[377.63881, "o", "echo \"# Convert to PyTorch tensors\r\n\u001b[?2004l\r"]
[377.638856, "o", "\u001b[?2004h"]
[377.638898, "o", "> "]
[377.639287, "o", "X_train_tensor = torch.tensor(X_train_scaled, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[377.639409, "o", "\u001b[?2004h> "]
