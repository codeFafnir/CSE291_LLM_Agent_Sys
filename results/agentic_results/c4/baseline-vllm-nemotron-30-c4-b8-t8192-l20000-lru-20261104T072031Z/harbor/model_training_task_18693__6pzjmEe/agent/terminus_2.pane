[?2004l[?2004h>         torch.save({
[?2004l[?2004h>             'epoch': epoch + 1,
[?2004l[?2004h>             'model_state': model.state_dict(),
[?2004l[?2004h>             'optimizer_state': optimizer.state_dict(),
