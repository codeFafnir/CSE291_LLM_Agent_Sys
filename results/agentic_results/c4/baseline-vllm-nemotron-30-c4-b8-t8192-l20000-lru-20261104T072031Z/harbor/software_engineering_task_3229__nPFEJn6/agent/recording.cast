[245.948175, "o", "import sys\r\nimport os\r\nimport subprocess\r\n\r\ntry:\r\n    # Build the package\r\n    subprocess.check_call([\"python3\", \"setup.py\", \"sdist\", \"bdist_wheel\"])\r\n    # Check for built packages\r\n    if not os.path.exists(\"dist\") or not os.listdir(\"dist\"):\r\n        raise Exception(\"No packages found in dist directory\")\r\n    # Check metadata\r\n    with open(\"setup.py\", \"r\") as f:\r\n        setup_content = f.read()\r\n        if \"correct-package-name\" not in setup_content or \"1.0.0\" not in setup_content:\r\n            raise Exception(\"Incorrect metadata in setup.py\")\r\n    # Check CLI command\r\n    subprocess.check_call([\"python33\", \"-c\", \"import mymodule.calculator; mymodule.calculator.main()\"])\r\n    print(\"All checks passed.\")\r\n    sys.exit(0)\r\nexcept Exception as e:\r\n    print(str(e), file=sys.stderr)\r\n    sys.exit(1)\r\n"]
