[10.992327, "o", "cat /app/input.json\r\n\u001b[?2004l\r"]
[10.993493, "o", "{\r\n  \"mass\": 1.0,\r\n  \"spring_constant\": 1.0,\r\n  \"initial_position\": 0.5,\r\n  \"initial_velocity\": 0.0,\r\n  \"time_step\": 0.01,\r\n  \"total_time\": 10.0,\r\n  \"energy_tolerance\": 0.1\r\n}"]
[10.993701, "o", "\u001b[?2004hroot@3da2b63402e7:/app# "]
