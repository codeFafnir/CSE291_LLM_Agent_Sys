[?2004hroot@a6bb8ff3f7ca:/app# echo "import os\nimport yaml\nimport json\nimport re\n\ndef validate_config(config):\n    errors = []\n    if not isinstance(config, dict):\n        errors.append('Configuration must be a dictionary.')\n    else:\n        if 'application' not in config or not isinstance(config['application'], str):\n            errors.append('Top-level 'application' key must be a string.')\n        if 'version' not in config or not isinstance(config['version'], str) or not re.match(r'\d+\.\d+\.\d+', config['version']):\n            errors.append('Top-level 'version' key must be a string in semantic version format (X.Y.Z).')\n        if 'settings' not in config or not isinstance(config['settings'], dict):\n            errors.append('Top-level 'settings' key must be a dictionary.')\n        for key in config:\n            if not isinstance(key, str):\n                errors.append(f'Key {key} must be a string.')\n    return errors\n\ndef detect_format(file_path):\n    with open(file_path, 'r') as file:\n        content = file.read()\n        try:\n            json.loads(content)\n            return 'json'\n        except json.JSONDecodeError:\n            try:\n                yaml.safe_load(content)\n                return 'yaml'\n            except yaml.YAMLError:\n                return 'unknown'\n\ndef main():\n    input_path = '/app/config.input'\n    output_path = '/app/config.output'\n    try:\n        with open(input_path, 'r') as file:\n            content = file.read()\n        format = detect_format(input_path)\n        if format == 'json':\n            config = json.loads(content)\n            errors = validate_config(config)\n            if errors:\n                with open(output_path, 'w') as out_file:\n                    out_file.write('VALIDATION FAILED\n')\n                    out_file.write('Errors:\n')\n                    for error in errors:\n                        out_file.write(f'- {error}\n')\n            else:\n                with open(output_path, 'w') as out_file:\n                    out_file.write(yaml.dump(config))\n        elif format == 'yaml':\n            config = yaml.safe_load(content)\n            errors = validate_config(config)\n            if errors:\n                with open(output_path, 'w') as out_file:\n                    out_file.write('VALIDATION FAILED\n')\n                    out_file.write('Errors:\n')\n                    for error in errors:\n                        out_file.write(f'- {error}\n')\n            else:\n                with open(output_path, 'w') as out_file:\n                    out_file.write(json.dumps(config, indent=2))\n        else:\n            with open(output_path, 'w') as out_file:\n                out_file.write('VALIDATION FAILED\n')\n                out_file.write('Errors:\n')\n                out_file.write(f'- Unable to detect format of the input file.')\n    except Exception as e:\n        with open(output_path, 'w') as out_file:\n            out_file.write('VALIDATION FAILED\n')\n            out_file.write('Errors:\n')\n            out_file.write(f'- {str(e)}\n')\n\nif __name__ == '__main__':\n    main()" > config_validator.py
