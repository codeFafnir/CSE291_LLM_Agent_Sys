[390.051126, "i", "cat > /app/fix_yaml.py << 'EOF'\nimport yaml\nfrom ruamel.yaml import YAML\n\n# Read the corrupted YAML file\nwith open('/app/build_config.yaml', 'r') as file:\n    data = yaml.safe_load(file)\n\n# Remove duplicate keys (keep the first occurrence)\nfixed_data = {}\nfor key, value in data.items():\n    if key not in fixed_data:\n        fixed_data[key] = value\n\ndata = fixed_data\n\n# Convert keys with dots to underscores\nfixed_data = {}\nfor key, value in data.items():\n    new_key = key.replace('.', '_')\n    fixed_data[new_key] = value\n\ndata = fixed_data\n\n# Uncomment lines that start with '# active:'\nwith open('/app/build_config.yaml', 'r') as file:\n    lines = file.readlines()\n\nfixed_lines = []\nfor line in lines:\n    if line.startswith('# active:'):\n        fixed_lines.append(line.lstrip('# ').strip() + '\\n')\n    else:\n        fixed_lines.append(line)\n\n# Ensure proper YAML indentation (2 spaces per level)\nfixed_yaml = ''\nindent = 0\nfor line in fixed_lines:\n    if line.strip().startswith('---'):\n        fixed_yaml += line\n        indent = 0\n    elif line.strip() == '' or line.strip().startswith('#'):\n        fixed_yaml += line\n    else:\n        fixed_yaml += '  ' * indent + line\n        if ':\n' in line:\n            indent += 1\n\n# Write the corrected configuration to the new file\nwith open('/app/fixed_config.yaml', 'w') as file:\n    file.write(fixed_yaml)\nEOF\n"]
