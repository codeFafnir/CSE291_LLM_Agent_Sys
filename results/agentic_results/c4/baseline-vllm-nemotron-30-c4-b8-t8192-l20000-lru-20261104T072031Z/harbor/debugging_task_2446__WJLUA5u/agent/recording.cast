[11.944337, "o", "{\r\n  \"project\": \"DataAnalysis_v2\",\r\n  \"version\": \"1.0\",\r\n  \"description\": \"Sample configuration for debugging task\",\r\n  \"records\": [\r\n    {\"id\": 1, \"value\": 42.5},\r\n    {\"id\": 2, \"value\": 87.3},\r\n    {\"id\": \"3\", \"value\": 15.8},\r\n    {\"id\": 4, \"value\": 63.1},\r\n    {\"id\": 5, \"value\": \"29.4\"},\r\n    {\"id\": 6},\r\n    {\"value\": 71.2},\r\n    {\"id\": 8, \"value\": 94.7},\r\n    {\"id\": 9, \"value\": 36.9},\r\n    {\"id\": 10, \"value\": 52.0}\r\n  ]\r\n}"]
