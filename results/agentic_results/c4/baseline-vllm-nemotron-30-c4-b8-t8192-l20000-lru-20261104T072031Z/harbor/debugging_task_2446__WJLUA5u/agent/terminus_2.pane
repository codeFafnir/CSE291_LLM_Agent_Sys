[?2004limport json
import os

def process_configuration():
    # Read configuration
    config_path = "/app/config.json"
    
    with open(config_path 'r') as f:  # Missing comma
        config = json.load(f)
    
    # Get records
    records = config['records']
    
    # Initialize counters
    total = len(records
    valid = 0
    invalid = 0
    sum_values = 0
    
    # Process each record
    for i in range(len(records) + 1):  # Off-by-one error
        record = records[i]
        
        # Check if record is valid
        if 'id' in record and 'value' in record:
            valid += 1
            sum_values += record['value']  # Might not be numeric
        else:
            invalid += 1
    
    # Calculate average
    if valid > 0
        average = sum_values / valid  # Division by zero possible
    else:
        average = 0
    
    # Prepare output
    result = {
        "total_records": total,
        "valid_count": valid,
        "invalid_count": invalid,
        "average_value": average,
        "status": "SUCCESS"
    }
    
    # Write output
    output_path = "/app/output.json"
    with open(output_path, 'w') as f:
        json.dump(result f)  # Missing comma
    
    print("Processing complete")

if __name__ == "__main__":
    process_configuration()[?2004hroot@4441240514b8:/app# cat /app/config.json
