[226.721465, "i", "echo \"import json\\nimport subprocess\\nfrom datetime import datetime\\n\\n# Load service configuration\\nwith open('/app/services.json') as f:\\n    services = json.load(f)\\n\\n# Initialize restart tracking\\nrestart_count = {service['name']: 0 for service in services}\\n\\n# Define health check function\\ndef is_service_healthy(service):\\n    # Check dependencies\\n    for dependency in service.get('dependencies', []):\\n        dependency_service = next((s for s in services if s['name'] == dependency), None)\\n        if not dependency_service:\\n            return False, 'dependency_failed', 'Dependency service not found: {}'.format(dependency)\\n\\n        # Check if dependency process is running\\n        process_check = subprocess.run(['pgrep', '-f', dependency_service['process']], capture_output=True, text=True)\\n        if process_check.returncode != 0:\\n            return False, 'dependency_failed', 'Dependency process not running: {}'.format(dependency)\\n\\n        # Check health check of dependency if provided\\n        if 'health_check' in dependency_service:\\n            health_check = subprocess.run(dependency_service['health_check'], shell=True, capture_output=True, text=True)\\n            if health_check.returncode != 0:\\n                return False, 'dependency_failed', 'Dependency health check failed: {}'.format(dependency)\\n\\n    # Check if main process is running\\n    process_check = subprocess.run(['pgrep', '-f', service['process']], capture_output=True, text=True)\\n    process_running = process_check.returncode == 0\\n\\n    # Check health check if provided\\n    health_check_passed = True\\n    health_check_reason = ''\\n    if 'health_check' in service:\\n        health_check = subprocess.run(service['health_check'], shell=True, capture_output=True, text=True)\\n        health_check_passed = health_check.returncode == 0\\n        if not health_check_passed:\\n            health_check_reason = 'Health check failed: {}'.format(health_check.stderr.strip())\\n\\n    # Determine service status\\n    if not process_running:\\n        return False, 'unhealthy', 'Process not running'\\n    if not health_check_passed:\\n        return False, 'unhealthy', health_check_reason\\n    return True, 'healthy', ''\\n\\n# Generate health report\\ndef generate_health_report():\\n    report = {\\n        'timestamp': datetime.now().isoformat(),\\n        'services': {},\\n        'summary': {\\n            'total_services': 0,\\n            'healthy': 0,\\n            'unhealthy': 0,\\n            'disabled': 0,\\n            'dependency_failed': 0\\n        }\\n    }\\n\\n    for service in services:\\n        name = service['name']\\n\\n        # Check if service is healthy\\n        is_healthy, status, reason = is_service_healthy(service)\\n\\n        # Track restarts in the last hour\\n        restarts_last_hour = restart_count[name]\\n\\n        # Check if max restarts are exceeded\\n        if restarts_last_hour >= service['max_restarts_per_hour']:\\n            status = 'disabled'\\n\\n        # Update report\\n        report['services'][name] = {\\n            'status': status,\\n            'process_running': process_running,\\n            'health_check_passed': health_check_passed,\\n            'dependencies_met': True if all((s for s in services if s['name'] == dependency), None) else False,\\n            'restarts_last_hour': restarts_last_hour,\\n            'last_check': datetime.now().isoformat()\\n        }\\n\\n    # Update summary\\n    for service in report['services'].values():\\n        report['summary'][service['status']] += 1\\n        report['summary']['total_services'] += 1\\n\\n    # Save report to file\\n    with open('/app/health_report.json', 'w') as f:\\n        json.dump(report, f, indent=4)\\n\\n    return report\\n\\n# Log restarts\\ndef log_restart(service_name, reason):\\n    with open('/app/restart_log.txt', 'a') as f:\\n        f.write(f\"[{datetime.now().isoformat()}Z] RESTART: {service_name} (reason: {reason})\\n\")\\n\\n# Main execution\\nif __name__ == '__main__':\\n    # Run health check for each service\\n    for service in services:\\n        name = service['name']\\"]
[226.721594, "i", "n\\n        # Check if service is healthy\\n        is_healthy, status, reason = is_service_healthy(service)\\n\\n        # If service is unhealthy, attempt to restart\\n        if not is_healthy:\\n            # Log restart\\n            log_restart(name, reason)\\n\\n            # Execute restart command\\n            restart_process = subprocess.run(service['restart'], shell=True, capture_output=True, text=True)\\n\\n            # Update restart count\\n            restart_count[name] += 1\\n\\n            # Check if max restarts are exceeded\\n            if restart_count[name] >= service['max_restarts_per_hour']:\\n                print(f\"Service {name} has been disabled due to exceeding max restarts.\")\\n\\n    # Generate health report\\n    generate_health_report()\" > /app/service_health_monitor.py\n"]
