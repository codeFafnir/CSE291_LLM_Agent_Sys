[269.286556, "o", "\u001b[?2004h> "]
[269.286715, "o", "    \"dependencies\": [\"database_service\"]\r\n\u001b[?2004l\r"]
[269.286768, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[269.28688, "o", "\u001b[?2004h> "]
[269.286978, "o", "]\" > /app/services.json\r\n\u001b[?2004l\r"]
[269.287348, "o", "\u001b[?2004hroot@68d64fed3fe7:/app# "]
