[257.019355, "o", "# Define health check function\r\n\u001b[?2004l\r"]
[257.019449, "o", "\u001b[?2004h> "]
[257.019614, "o", "def is_service_healthy(service):\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.019662, "o", "> "]
[257.019802, "o", "    # Check dependencies\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.019883, "o", "> "]
[257.020186, "o", "    for dependency in service.get('dependencies', []):\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.020234, "o", "> "]
[257.020812, "o", "        dependency_service = next((s for s in services if s['name'] == dependency), None)\r\n\u001b[?2004l\r"]
[257.020859, "o", "\u001b[?2004h> "]
[257.021057, "o", "        if not dependency_service:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.021139, "o", "> "]
[257.021562, "o", "            return False, 'dependency_failed', 'Dependency service not found: {}'.format(dependency)\r\n\u001b[?2004l\r"]
[257.021613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_"]
[257.021668, "o", "\u001b[?2004h> "]
[257.021852, "o", "        # Check if dependency process is running\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.021907, "o", "> "]
[257.022244, "o", "        process_check = subprocess.run(['pgrep', '-f', dependency_service['process']], capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.022337, "o", "> "]
[257.022411, "o", "        if process_check.returncode != 0:\r\n\u001b[?2004l\r"]
[257.02246, "o", "\u001b[?2004h> "]
[257.022795, "o", "            return False, 'dependency_failed', 'Dependency process not running: {}'.format(dependency)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.022868, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.023069, "o", "        # Check health check of dependency if provided\r\n\u001b[?2004l\r"]
[257.023142, "o", "\u001b[?2004h> "]
[257.023293, "o", "        if 'health_check' in dependency_service:\r\n\u001b[?2004l\r"]
[257.023375, "o", "\u001b[?2004h> "]
[257.023743, "o", "            health_check = subprocess.run(dependency_service['health_check'], shell=True, capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[257.023817, "o", "\u001b[?2004h> "]
[257.023952, "o", "            if health_check.returncode != 0:\r\n\u001b[?2004l\r"]
[257.024025, "o", "\u001b[?2004h> "]
[257.024363, "o", "                return False, 'dependency_failed', 'Dependency health check failed: {}'.format(dependency)\r\n\u001b[?2004l\r"]
[257.024442, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.024615, "o", "    # Check if main process is running\r\n\u001b[?2004l\r"]
[257.024668, "o", "\u001b[?2004h> "]
[257.025007, "o", "    process_check = subprocess.run(['pgrep', '-f', service['process']], capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.025062, "o", "> "]
[257.025202, "o", "    process_running = process_check.returncode == 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.025252, "o", "\u001b[?2004h> "]
[257.025377, "o", "    # Check health check if provided\r\n\u001b[?2004l\r"]
[257.025443, "o", "\u001b[?2004h> "]
[257.025493, "o", "    health_check_passed = True\r\n\u001b[?2004l\r"]
[257.025605, "o", "\u001b[?2004h>     health_check_reason = ''\r\n\u001b[?2004l\r"]
[257.025656, "o", "\u001b[?2004h> "]
[257.025765, "o", "    if 'health_check' in service:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.025816, "o", "> "]
[257.026114, "o", "        health_check = subprocess.run(service['health_check'], shell=True, capture_output=True, text=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.026161, "o", "> "]
[257.02632, "o", "        health_check_passed = health_check.returncode == 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.026369, "o", "> "]
[257.026477, "o", "        if not health_check_passed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.026781, "o", "            health_check_reason = 'Health check failed: {}'.format(health_check.stderr.strip())\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.026829, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.026948, "o", "    # Determine service status\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.02701, "o", "> "]
[257.027062, "o", "    if not process_running:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.027109, "o", "> "]
[257.027261, "o", "        return False, 'unhealthy', 'Process not running'\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.027325, "o", "> "]
[257.027413, "o", "    if not health_check_passed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.027457, "o", "> "]
[257.027642, "o", "        return False, 'unhealthy', health_check_reason\r\n\u001b[?2004l\r"]
[257.027705, "o", "\u001b[?2004h> "]
[257.027842, "o", "    return True, 'healthy', ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.027898, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.028016, "o", "# Generate health report\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.028068, "o", "> "]
[257.028137, "o", "def generate_health_report():\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.028188, "o", "> "]
[257.028244, "o", "    report = {\r\n\u001b[?2004l\r"]
[257.028292, "o", "\u001b[?2004h> "]
[257.028448, "o", "        'timestamp': datetime.now().isoformat(),\r\n\u001b[?2004l\r"]
[257.028524, "o", "\u001b[?2004h> "]
[257.028582, "o", "        'services': {},\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.028629, "o", "> "]
[257.028688, "o", "        'summary': {\r\n\u001b[?2004l\r"]
[257.028741, "o", "\u001b[?2004h> "]
[257.028923, "o", "            'total_services': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.028977, "o", "            'healthy': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.029103, "o", "            'unhealthy': 0,\r\n\u001b[?2004l\r"]
[257.029151, "o", "\u001b[?2004h> "]
[257.029261, "o", "            'disabled': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.02938, "o", "            'dependency_failed': 0\r\n\u001b[?2004l\r"]
[257.029432, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[257.029549, "o", "\u001b[?2004h> "]
[257.029654, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.029704, "o", "    for service in services:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.029745, "o", "> "]
[257.02989, "o", "        name = service['name']\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.029947, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.030066, "o", "        # Check if service is healthy\r\n\u001b[?2004l\r"]
[257.030148, "o", "\u001b[?2004h> "]
[257.030329, "o", "        is_healthy, status, reason = is_service_healthy(service)\r\n\u001b[?2004l\r"]
[257.030413, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.030558, "o", "        # Track restarts in the last hour\r\n\u001b[?2004l\r"]
[257.030644, "o", "\u001b[?2004h> "]
[257.030775, "o", "        restarts_last_hour = restart_count[name]\r\n\u001b[?2004l\r"]
[257.030826, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.030984, "o", "        # Check if max restarts are exceeded\r\n\u001b[?2004l\r"]
[257.031073, "o", "\u001b[?2004h> "]
[257.031249, "o", "        if restarts_last_hour >= service['max_restarts_per_hour']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.031293, "o", "> "]
[257.031395, "o", "            status = 'disabled'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.031515, "o", "\u001b[?2004h> "]
[257.031619, "o", "        # Update report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.031709, "o", "        report['services'][name] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.031805, "o", "> "]
[257.031906, "o", "            'status': status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.03204, "o", "            'process_running': process_running,\r\n\u001b[?2004l\r"]
[257.032121, "o", "\u001b[?2004h> "]
[257.032258, "o", "            'health_check_passed': health_check_passed,\r\n\u001b[?2004l\r"]
[257.032302, "o", "\u001b[?2004h> "]
[257.032643, "o", "            'dependencies_met': True if all((s for s in services if s['name'] == dependency), None) else False,\r\n\u001b[?2004l\r"]
[257.032722, "o", "\u001b[?2004h> "]
[257.032853, "o", "            'restarts_last_hour': restarts_last_hour,\r\n\u001b[?2004l\r"]
[257.032901, "o", "\u001b[?2004h> "]
[257.033062, "o", "            'last_check': datetime.now().isoformat()\r\n\u001b[?2004l\r"]
[257.033116, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[257.033228, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.033281, "o", "    # Update summary\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.033326, "o", "> "]
[257.033498, "o", "    for service in report['services'].values():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.033679, "o", "        report['summary'][service['status']] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.033738, "o", "> "]
[257.033877, "o", "        report['summary']['total_services'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.033965, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.034049, "o", "    # Save report to file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.034235, "o", "    with open('/app/health_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[257.034285, "o", "\u001b[?2004h> "]
[257.034412, "o", "        json.dump(report, f, indent=4)\r\n\u001b[?2004l\r"]
[257.034463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.034531, "o", "    return report\r\n\u001b[?2004l\r"]
[257.034577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.034755, "o", "> # Log restarts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.034842, "o", "def log_restart(service_name, reason):\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.03495, "o", "> "]
[257.035055, "o", "    with open('/app/restart_log.txt', 'a') as f:\r\n\u001b[?2004l\r"]
[257.035147, "o", "\u001b[?2004h> "]
[257.035418, "o", "        f.write(f\"[{datetime.now().isoformat()}Z] RESTART: {service_name} (reason: {reason})\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.035511, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.035566, "o", "# Main execution\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.035663, "o", "> "]
[257.035774, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.035862, "o", "    # Run health check for each service\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.035956, "o", "> "]
[257.036009, "o", "    for service in services:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.036149, "o", "        name = service['name']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[257.036202, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[257.036374, "o", "        # Check if service is healthy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.036659, "o", "        is_healthy, status, reason = is_service_healthy(service)\r\n\u001b[?2004l\r"]
[257.03671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.036761, "o", "\u001b[?2004h> "]
[257.03697, "o", "        # If service is unhealthy, attempt to restart\r\n\u001b[?2004l\r"]
[257.037016, "o", "\u001b[?2004h> "]
[257.037127, "o", "        if not is_healthy:\r\n\u001b[?2004l\r"]
[257.037217, "o", "\u001b[?2004h> "]
[257.037315, "o", "            # Log restart\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.037361, "o", "> "]
[257.037509, "o", "            log_restart(name, reason)\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.037551, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.037633, "o", "> "]
[257.037775, "o", "            # Execute restart command\r\n\u001b[?2004l\r"]
[257.037833, "o", "\u001b[?2004h> "]
[257.038289, "o", "            restart_process = subprocess.run(service['restart'], shell=True, capture_output=True, text=True)\r\n\u001b[?2004l\r"]
[257.038358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.038416, "o", "> "]
[257.038561, "o", "            # Update restart count\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.038662, "o", "> "]
[257.03876, "o", "            restart_count[name] += 1\r\n\u001b[?2004l\r"]
[257.03882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.038877, "o", "\u001b[?2004h> "]
[257.039075, "o", "            # Check if max restarts are exceeded\r\n\u001b[?2004l\r"]
[257.039134, "o", "\u001b[?2004h> "]
[257.039446, "o", "            if restart_count[name] >= service['max_restarts_per_hour']:\r\n\u001b[?2004l\r"]
[257.039499, "o", "\u001b[?2004h> "]
[257.039879, "o", "                print(f\"Service {name} has been disabled due to exceeding max restarts.\")\r\n\u001b[?2004l\r"]
[257.039984, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.040074, "o", "\u001b[?2004h> "]
[257.040121, "o", "    # Generate health report\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.040227, "o", "> "]
[257.040314, "o", "    generate_health_report()\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.040395, "o", "> EOF\r\n\u001b[?2004l\r"]
[257.041696, "o", "\u001b[?2004hroot@68d64fed3fe7:/app# "]
[269.283773, "i", "echo \"[\n  {\n    \"name\": \"database_service\",\n    \"process\": \"mysqld\",\n    \"health_check\": \"mysql -u root -p password -e 'SELECT 1'\",\n    \"restart\": \"systemctl restart mysql\",\n    \"max_restarts_per_hour\": 3,\n    \"dependencies\": []\n  },\n  {\n    \"name\": \"web_server\",\n    \"process\": \"nginx\",\n    \"health_check\": \"curl -s http://localhost\",\n    \"restart\": \"systemctl restart nginx\",\n    \"max_restarts_per_hour\": 3,\n    \"dependencies\": [\"database_service\"]\n  }\n]\" > /app/services.json\n"]
[269.283959, "o", "echo \"[\r\n\u001b[?2004l\r"]
[269.284106, "o", "\u001b[?2004h>   {\r\n\u001b[?2004l\r"]
[269.284206, "o", "\u001b[?2004h> "]
