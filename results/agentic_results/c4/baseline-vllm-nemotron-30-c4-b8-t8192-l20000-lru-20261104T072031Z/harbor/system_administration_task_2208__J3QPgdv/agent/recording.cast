[387.340701, "o", "> "]
[387.340824, "o", "            'healthy': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[387.340962, "o", "            'unhealthy': 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[387.341014, "o", "> "]
