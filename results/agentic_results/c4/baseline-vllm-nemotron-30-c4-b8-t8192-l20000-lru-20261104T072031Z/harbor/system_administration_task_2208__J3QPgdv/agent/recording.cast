[269.284768, "o", "    \"health_check\": \"mysql -u root -p password -e 'SELECT 1'\",\r\n\u001b[?2004l\r"]
[269.28495, "o", "\u001b[?2004h> "]
[269.28507, "o", "    \"restart\": \"systemctl restart mysql\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.28521, "o", "    \"max_restarts_per_hour\": 3,\r\n\u001b[?2004l\r"]
[269.285262, "o", "\u001b[?2004h> "]
[269.285421, "o", "    \"dependencies\": []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.285593, "o", "  },\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.285704, "o", "    \"name\": \"web_server\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.285771, "o", "> "]
