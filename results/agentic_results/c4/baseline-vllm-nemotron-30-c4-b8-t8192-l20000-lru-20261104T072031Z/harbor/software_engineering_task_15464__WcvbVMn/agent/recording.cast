[424.300695, "o", "\u001b[?2004h> "]
[424.300882, "o", "        allowed_modules = [line.strip() for line in f]\r\n\u001b[?2004l\r"]
[424.300938, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.300989, "o", "\u001b[?2004h> "]
[424.301103, "o", "    valid_files = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.301216, "o", "    invalid_files = {}\r\n\u001b[?2004l\r"]
[424.301266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.301319, "o", "\u001b[?2004h> "]
[424.301435, "o", "    for file in parsed_data:\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.301485, "o", "> "]
[424.301773, "o", "        invalid_imports = [imp for imp in file['imports'] if imp not in allowed_modules]\r\n\u001b[?2004l\r"]
[424.301827, "o", "\u001b[?2004h> "]
[424.301943, "o", "        if not invalid_imports:\r\n\u001b[?2004l\r"]
[424.302033, "o", "\u001b[?2004h> "]
[424.302171, "o", "            valid_files.append(file['filename'])\r\n\u001b[?2004l\r"]
[424.302265, "o", "\u001b[?2004h> "]
[424.302361, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.302551, "o", "            invalid_files[file['filename']] = invalid_imports\r\n\u001b[?2004l\r"]
[424.30265, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.30275, "o", "\u001b[?2004h> "]
[424.302841, "o", "    validation_passed = len(invalid_files) == 0\r\n\u001b[?2004l\r"]
[424.302893, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.302999, "o", "\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[424.303092, "o", "\u001b[?2004h> "]
[424.303201, "o", "        'valid_files': valid_files,\r\n\u001b[?2004l\r"]
[424.303254, "o", "\u001b[?2004h> "]
[424.303398, "o", "        'invalid_files': invalid_files,\r\n\u001b[?2004l\r"]
[424.303451, "o", "\u001b[?2004h> "]
[424.303675, "o", "        'validation_passed': validation_passed\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.303729, "o", ">     }\r\n\u001b[?2004l\r"]
[424.303831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.303961, "o", "# Step 4: Generate build order\r\n\u001b[?2004l\r"]
[424.304056, "o", "\u001b[?2004h> "]
[424.304146, "o", "def generate_build_order(graph):\r\n\u001b[?2004l\r"]
[424.304237, "o", "\u001b[?2004h> "]
[424.304409, "o", "    # This is a simplified implementation for demonstration\r\n\u001b[?2004l\r"]
[424.304507, "o", "\u001b[?2004h> "]
[424.304701, "o", "    # A full implementation would use topological sorting algorithms\r\n\u001b[?2004l\r"]
[424.304748, "o", "\u001b[?2004h> "]
[424.304955, "o", "    build_order = ['file3.txt', 'file2.yaml', 'file1.json']\r\n\u001b[?2004l\r"]
[424.305041, "o", "\u001b[?2004h> "]
[424.305113, "o", "    return build_order\r\n\u001b[?2004l\r"]
[424.305199, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.305293, "o", "\u001b[?2004h> "]
[424.305378, "o", "# Step 5: Create Makefile configuration\r\n\u001b[?2004l\r"]
[424.305432, "o", "\u001b[?2004h> "]
[424.305581, "o", "def create_makefile_snippet(parsed_data):\r\n\u001b[?2004l\r"]
[424.30563, "o", "\u001b[?2004h> "]
[424.305961, "o", "    makefile_content = 'compile_all: ' + ' '.join([file['filename'] for file in parsed_data]) + '\\n\\n'\r\n\u001b[?2004l\r"]
[424.306017, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.306138, "o", "\u001b[?2004h> "]
[424.306191, "o", "    for file in parsed_data:\r\n\u001b[?2004l\r"]
[424.306243, "o", "\u001b[?2004h> "]
[424.306669, "o", "        makefile_content += f\"{file['filename']}: \" + ' '.join(file['imports']) + '\\n' + f\"\\t@echo 'Compiling {file['filename']}'\\n\\n\"\r\n\u001b[?2004l\r"]
[424.306724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.306773, "o", "\u001b[?2004h> "]
[424.306886, "o", "    return makefile_content\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.306942, "o", "> \r\n\u001b[?2004l\r"]
[424.30699, "o", "\u001b[?2004h> "]
[424.307116, "o", "# Main execution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[424.307176, "o", "def main():\r\n\u001b[?2004l\r"]
[424.307229, "o", "\u001b[?2004h> "]
[424.307375, "o", "    parsed_data = parse_source_files()\r\n\u001b[?2004l\r"]
[424.307429, "o", "\u001b[?2004h> "]
[424.30759, "o", "    graph = build_dependency_graph(parsed_data)\r\n\u001b[?2004l\r"]
[424.307684, "o", "\u001b[?2004h> "]
[424.307814, "o", "    validation = validate_imports(parsed_data)\r\n\u001b[?2004l\r"]
[424.307867, "o", "\u001b[?2004h> "]
[424.308033, "o", "    build_order = generate_build_order(graph)\r\n\u001b[?2004l\r"]
[424.308086, "o", "\u001b[?2004h> "]
[424.30829, "o", "    makefile_snippet = create_makefile_snippet(parsed_data)\r\n\u001b[?2004l\r"]
[424.308388, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.308442, "o", "\u001b[?2004h> "]
[424.308553, "o", "    # Write graph to file\r\n\u001b[?2004l\r"]
[424.308646, "o", "\u001b[?2004h> "]
[424.30876, "o", "    with open('/app/output/graph.json', 'w') as f:\r\n\u001b[?2004l\r"]
[424.308842, "o", "\u001b[?2004h> "]
[424.308929, "o", "        json.dump(graph, f)\r\n\u001b[?2004l\r"]
[424.30898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.309092, "o", "\u001b[?2004h> "]
[424.309187, "o", "    # Write validation results to file\r\n\u001b[?2004l\r"]
[424.30924, "o", "\u001b[?2004h> "]
[424.309432, "o", "    with open('/app/output/validation.json', 'w') as f:\r\n\u001b[?2004l\r"]
[424.309524, "o", "\u001b[?2004h> "]
[424.309616, "o", "        json.dump(validation, f)\r\n\u001b[?2004l\r"]
[424.309668, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.309721, "o", "\u001b[?2004h> "]
[424.309841, "o", "    # Write build order to file\r\n\u001b[?2004l\r"]
[424.309936, "o", "\u001b[?2004h> "]
[424.310094, "o", "    with open('/app/output/build_order.txt', 'w') as f:\r\n\u001b[?2004l\r"]
[424.310147, "o", "\u001b[?2004h> "]
[424.310341, "o", "        f.write('# Build order (topological sort)\\n')\r\n\u001b[?2004l\r"]
[424.310393, "o", "\u001b[?2004h> "]
[424.310508, "o", "        for file in build_order:\r\n\u001b[?2004l\r"]
[424.310557, "o", "\u001b[?2004h> "]
[424.310682, "o", "            f.write(f\"{file}\\n\")\r\n\u001b[?2004l\r"]
[424.310774, "o", "\u001b[?2004h> "]
[424.310968, "o", "        f.write('\\n# Circular dependencies (build after others)\\n')\r\n\u001b[?2004l\r"]
[424.311019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.311122, "o", "\u001b[?2004h> "]
[424.311227, "o", "    # Write Makefile snippet to file\r\n\u001b[?2004l\r"]
[424.311318, "o", "\u001b[?2004h> "]
[424.311485, "o", "    with open('/app/output/Makefile.snippet', 'w') as f:\r\n\u001b[?2004l\r"]
[424.311534, "o", "\u001b[?2004h> "]
[424.311667, "o", "        f.write(makefile_snippet)\r\n\u001b[?2004l\r"]
[424.311763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[424.311855, "o", "\u001b[?2004h> "]
[424.311909, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[424.311956, "o", "> "]
[424.312103, "o", "    main()\r\n\u001b[?2004l\r"]
[424.312208, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[424.313327, "o", "\u001b[?2004hroot@099d573c44fa:/app# "]
[434.29312, "i", "python3 build_orchestrator.py\n"]
[434.293381, "o", "python3 build_orchestrator.py\r\n\u001b[?2004l\r"]
[434.327895, "o", "\u001b[?2004hroot@099d573c44fa:/app# "]
