[509.436836, "i", "cat > config_migration.py << EOF\nimport json\nimport yaml\nimport sys\nfrom datetime import datetime\n\ntry:\n    # Read JSON configuration\n    with open('/app/input/config.json', 'r') as json_file:\n        config = json.load(json_file)\n\n    # Add metadata\n    metadata = {\n        'converted_at': datetime.utcnow().isoformat(),\n        'original_format': 'json',\n        'original_path': '/app/input/config.json'\n    }\n    config['_metadata'] = metadata\n\n    # Write YAML configuration\n    with open('/app/output/config.yaml', 'w') as yaml_file:\n        yaml.dump(config, yaml_file, default_flow_style=False)\n\n    # Generate report\n    top_level_keys = [key for key in config if not key.startswith('_')]\n    top_level_keys.sort()\n\n    with open('/app/output/report.txt', 'w') as report_file:\n        report_file.write(f'top_level_keys: {len(top_level_keys)}\\n')\n        report_file.write(f'keys: {','.join(top_level_keys)}\\n')\n        report_file.write('success: True\\n')\n\nexcept Exception as e:\n    print(f'Error: {e}', file=sys.stderr)\n    with open('/app/output/report.txt', 'w') as report_file:\n        report_file.write('top_level_keys: 0\\n')\n        report_file.write('keys: \\n')\n        report_file.write('success: False\\n')\nEOF\n"]
