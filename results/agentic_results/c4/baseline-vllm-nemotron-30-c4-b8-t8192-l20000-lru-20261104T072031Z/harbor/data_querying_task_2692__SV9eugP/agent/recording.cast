[15.184046, "i", "echo \"@prefix ex: <http://example.org/> .\n@prefix dc: <http://purl.org/dc/elements/1.1/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n\nSELECT ?title ?authorName {\n  ?book rdf:type ex:Book ;\n        dc:title ?title ;\n        dc:creator ?author .\n  ?author dc:title ?authorName .\n  FILTER (?book/dc:subject = \"Classic\")\n} ORDER BY ?title\" > /app/classic_books_query.sparql\n"]
[15.184483, "o", "echo \"@prefix ex: <http://example.org/> .\r\n\u001b[?2004l\r"]
