Sending keys: ["cat > process_survey.py << EOF\nimport pandas as pd\nimport json\n\n# Load the survey data\ndata = pd.read_csv('survey_data.csv')\n\n# Fill missing satisfaction_score with median per region\nmedian_scores = data.groupby('region')['satisfaction_score'].transform('median')\ndata['satisfaction_score'].fillna(median_scores, inplace=True)\n\n# Create satisfaction_category column\ndata['satisfaction_category'] = pd.cut(\n    data['satisfaction_score'],\n    bins=[-1, 3, 6, 10],\n    labels=['Dissatisfied', 'Neutral', 'Satisfied'],\n    include_lowest=True\n)\n\n# Save the cleaned data\ndata.to_csv('cleaned_survey_data.csv', index=False)\n\n# Calculate summary statistics\nsummary_stats = data.groupby('region')['satisfaction_score'].agg(\n    count=('satisfaction_score', 'count'),\n    mean=('satisfaction_score', 'mean'),\n    median=('satisfaction_score', 'median'),\n    std=('satisfaction_score', 'std')\n).reset_index()\n\n# Generate summary report\ntotal_responses = len(data)\noverall_satisfaction = data['satisfaction_score'].mean()\nsatisfaction_distribution = data['satisfaction_category'].value_counts().to_dict()\nby_region = summary_stats.set_index('region')[['mean']].to_dict()['mean']\nbest_region = summary_stats.loc[summary_stats['mean'].idxmax()]['region']\nworst_region = summary_stats.loc[summary_stats['mean'].idxmin()]['region']\n\n# Save the summary report\nwith open('summary_report.json', 'w') as f:\n    json.dump({\n        'total_responses': total_responses,\n        'overall_satisfaction': round(overall_satisfaction, 2),\n        'by_region': by_region,\n        'satisfaction_distribution': satisfaction_distribution,\n        'best_region': best_region,\n        'worst_region': worst_region\n    }, f)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
