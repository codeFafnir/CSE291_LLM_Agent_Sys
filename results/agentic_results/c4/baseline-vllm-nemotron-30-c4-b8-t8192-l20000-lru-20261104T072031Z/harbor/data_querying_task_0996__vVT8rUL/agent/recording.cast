[10.361505, "o", "@prefix ex: <http://example.org/library#> .\r\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\r\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\r\n\r\nex:book1 a ex:Book ;\r\n    ex:title \"The Testaments\" ;\r\n    ex:author ex:author1 ;\r\n    ex:publicationYear 2019 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book2 a ex:Book ;\r\n    ex:title \"Circe\" ;\r\n    ex:author ex:author2 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book3 a ex:Book ;\r\n    ex:title \"Educated\" ;\r\n    ex:author ex:author3 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Non-Fiction\" .\r\n\r\nex:book4 a ex:Book ;\r\n    ex:title \"The Overstory\" ;\r\n    ex:author ex:author4 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book5 a ex:Book ;\r\n    ex:title \"The Silent Patient\" ;\r\n    ex:author ex:author5 ;\r\n    ex:publicationYear 2019 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book6 a ex:Book ;\r\n    ex:title \"Where the Crawdads Sing\" ;\r\n    ex:author ex:author6 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book7 a ex:Book ;\r\n    ex:title \"Becoming\" ;\r\n    ex:author ex:author7 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Biography\" .\r\n\r\nex:book8 a ex:Book ;\r\n    ex:title \"Normal People\" ;\r\n    ex:author ex:author8 ;\r\n    ex:publicationYear 2018 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:book9 a ex:Book ;\r\n    ex:title \"Klara and the Sun\" ;\r\n    ex:author ex:author9 ;\r\n    ex:publicationYear 2021 ;\r\n    ex:genre \"Fiction\" .\r\n\r\nex:author1 a ex:Author ;\r\n    ex:name \"Margaret Atwood\" ;\r\n    ex:nationality \"Canadian\" .\r\n\r\nex:author2 a ex:Author ;\r\n    ex:name \"Madeline Miller\" ;\r\n    ex:nationality \"American\" .\r\n\r\nex:author3 a ex:Author ;\r\n    ex:name \"Tara Westover\" ;\r\n    ex:nationality \"American\" .\r\n\r\n"]
[10.361628, "o", "ex:author4 a ex:Author ;\r\n    ex:name \"Richard Powers\" ;\r\n    ex:nationality \"American\" .\r\n\r\nex:author5 a ex:Author ;\r\n    ex:name \"Alex Michaelides\" ;\r\n    ex:nationality \"British\" .\r\n\r\nex:author6 a ex:Author ;\r\n    ex:name \"Delia Owens\" ;\r\n    ex:nationality \"American\" .\r\n\r\nex:author7 a ex:Author ;\r\n    ex:name \"Michelle Obama\" ;\r\n    ex:nationality \"American\" .\r\n\r\nex:author8 a ex:Author ;\r\n    ex:name \"Sally Rooney\" ;\r\n    ex:nationality \"Irish\" .\r\n\r\nex:author9 a ex:Author ;\r\n    ex:name \"Kazuo Ishiguro\" ;\r\n    ex:nationality \"British\" ."]
