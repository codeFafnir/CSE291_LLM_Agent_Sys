[33.77054, "i", "python3 -c \"import rdflib; g = rdflib.Graph(); g.parse('/app/library.ttl', format='turtle'); qres = g.query('''PREFIX ex: <http://example.org/library#> SELECT ?bookTitle ?authorName ?publicationYear WHERE { ?book a ex:Book ; ex:title ?bookTitle ; ex:author ?author ; ex:publicationYear ?publicationYear ; ex:genre \"Fiction\" . ?author a ex:Author ; ex:name ?authorName ; ex:nationality \"American\" . FILTER(?publicationYear > 2015) } ORDER BY ?publicationYear ?bookTitle ''')\n; import csv; with open('/app/query_results.csv', 'w') as f: csv.writer(f).writerows([['bookTitle', 'authorName', 'publicationYear']] + [[str(row.bookTitle), str(row.authorName), str(row.publicationYear)] for row in qres])\" \n"]
