[10.613011, "o", "cat message_queue.py\r\n\u001b[?2004l\r"]
[10.61408, "o", "import threading\r\nimport time\r\nimport random\r\nfrom collections import deque\r\nfrom dataclasses import dataclass\r\nfrom typing import Optional\r\n\r\n@dataclass\r\nclass Message:\r\n    id: int\r\n    content: str\r\n    timestamp: float\r\n\r\nclass MessageQueue:\r\n    \"\"\"Thread-safe message queue with performance issues.\"\"\"\r\n    \r\n    def __init__(self, max_size: int = 10000):\r\n        self._queue = deque()\r\n        self._max_size = max_size\r\n        self._lock = threading.Lock()\r\n        self._processed_ids = set()\r\n        self._waiting_consumers = []\r\n        self._stats = {\r\n            'enqueue_count': 0,\r\n            'dequeue_count': 0,\r\n            'duplicate_count': 0,\r\n            'lost_count': 0\r\n        }\r\n    \r\n    def enqueue(self, content: str) -> bool:\r\n        \"\"\"Add a message to the queue. Returns True if successful.\"\"\"\r\n        message_id = hash(content)  # Simple ID generation\r\n        \r\n        # CRITICAL BUG: This busy-wait loop causes high CPU usage\r\n        while len(self._queue) >= self._max_size:\r\n            time.sleep(0.001)  # Busy wait\r\n        \r\n        with self._lock:\r\n            # Check for duplicates (but this causes race condition)\r\n            if message_id in self._processed_ids:\r\n                self._stats['duplicate_count'] += 1\r\n                return False\r\n            \r\n            message = Message(\r\n                id=message_id,\r\n                content=content,\r\n                timestamp=time.time()\r\n            )\r\n            \r\n            # PERFORMANCE BUG: This linear search is O(n)\r\n            for msg in self._queue:\r\n                if msg.id == message_id:\r\n                    self._stats['duplicate_count'] += 1\r\n                    return False\r\n            \r\n            self._queue.append(message)\r\n            self._stats['enqueue_count'] += 1\r\n            \r\n            # Notify waiting consumers (buggy implementation)\r\n            if self._waiting_consumers:\r\n                # BUG: This can cause duplicate processing\r\n                consumer = self._waiting_consumers.pop(0)\r\n                consumer.set()\r\n            \r\n            return True\r\n    \r\n    def dequeue(self, timeout: float = 1.0) -> Optional[Message]:\r\n        \"\"\"Remove and return a message from the queue.\"\"\"\r\n        start_time = time.time()\r\n        \r\n        # BUG: This polling loop wastes CPU cycles\r\n        while time.time() - start_time < timeout:\r\n            with self._lock:\r\n                if self._queue:\r\n                    message = self._queue.popleft()\r\n                    \r\n                    # BUG: Race condition - processed_ids check is not atomic with dequeue\r\n                    if message.id in self._processed_ids:\r\n"]
[10.614134, "o", "                        self._stats['duplicate_count'] += 1\r\n                        continue\r\n                    \r\n                    self._processed_ids.add(message.id)\r\n                    self._stats['dequeue_count'] += 1\r\n                    return message\r\n            \r\n            # Inefficient wait\r\n            event = threading.Event()\r\n            self._waiting_consumers.append(event)\r\n            # BUG: Event might not be cleared if no producer comes\r\n            event.wait(0.01)\r\n        \r\n        self._stats['lost_count'] += 1\r\n        return None\r\n    \r\n    def size(self) -> int:\r\n        \"\"\"Return current queue size.\"\"\"\r\n        with self._lock:\r\n            return len(self._queue)\r\n    \r\n    def get_stats(self) -> dict:\r\n        \"\"\"Get queue statistics.\"\"\"\r\n        with self._lock:\r\n            return self._stats.copy()\r\n\r\n# Test functions (for the reproduction test)\r\ndef test_concurrent_access():\r\n    \"\"\"Test that reproduces the performance and corruption issues.\"\"\"\r\n    queue = MessageQueue()\r\n    \r\n    def producer(pid, num_messages):\r\n        for i in range(num_messages):\r\n            queue.enqueue(f\"producer_{pid}_message_{i}\")\r\n    \r\n    def consumer(cid, results, num_messages):\r\n        for _ in range(num_messages):\r\n            msg = queue.dequeue()\r\n            if msg:\r\n                results.append((cid, msg.content))\r\n    \r\n    # Run test\r\n    num_producers = 5\r\n    num_consumers = 3\r\n    messages_per = 200\r\n    \r\n    producers = []\r\n    consumers = []\r\n    all_results = []\r\n    \r\n    start_time = time.time()\r\n    \r\n    for i in range(num_producers):\r\n        p = threading.Thread(target=producer, args=(i, messages_per))\r\n        producers.append(p)\r\n        p.start()\r\n    \r\n    for i in range(num_consumers):\r\n        results = []\r\n        all_results.append(results)\r\n        c = threading.Thread(target=consumer, args=(i, results, messages_per))\r\n        consumers.append(c)\r\n        c.start()\r\n    \r\n    for p in producers:\r\n        p.join()\r\n    \r\n    for c in consumers:\r\n        c.join()\r\n    \r\n    end_time = time.time()\r\n    \r\n    # Calculate throughput\r\n    total_messages = num_producers * messages_per\r\n    duration = end_time - start_time\r\n    throughput = total_messages / duration if duration > 0 else 0\r\n    \r\n    # Check for duplicates\r\n"]
[10.614201, "o", "    all_messages = []\r\n    for results in all_results:\r\n        all_messages.extend([msg for _, msg in results])\r\n    \r\n    unique_messages = set(all_messages)\r\n    duplicates = len(all_messages) - len(unique_messages)\r\n    \r\n    stats = queue.get_stats()\r\n    \r\n    return {\r\n        'throughput': throughput,\r\n        'duplicates': duplicates,\r\n        'lost': stats['lost_count'],\r\n        'total_processed': len(all_messages),\r\n        'expected_total': total_messages\r\n    }\r\n\r\nif __name__ == \"__main__\":\r\n    # Quick demonstration of the issues\r\n    print(\"Running quick test...\")\r\n    results = test_concurrent_access()\r\n    print(f\"Throughput: {results['throughput']:.1f} messages/sec\")\r\n    print(f\"Duplicates: {results['duplicates']}\")\r\n    print(f\"Lost messages: {results['lost']}\")\r\n    print(f\"Processed: {results['total_processed']} / Expected: {results['expected_total']}\")"]
