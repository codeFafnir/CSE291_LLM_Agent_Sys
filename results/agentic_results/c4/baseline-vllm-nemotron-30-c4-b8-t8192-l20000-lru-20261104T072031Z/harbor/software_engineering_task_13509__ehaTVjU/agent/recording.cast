[115.510863, "i", "cat << EOF > generate_makefile.py\nimport json\nimport os\n\n# Read configuration\nwith open('/app/project_config.json', 'r') as f:\n    config = json.load(f)\n\n# Validate configuration\nrequired_fields = ['project_name', 'target_type', 'sources', 'headers', 'compiler', 'standard', 'optimization', 'include_dirs', 'library_dirs', 'libraries', 'defines', 'warnings', 'output_dir', 'clean_patterns']\n\nerrors = []\nfor field in required_fields:\n    if field not in config:\n        errors.append(f'Missing required field: {field}')\n\nif config['target_type'] not in ['executable', 'static_lib', 'shared_lib']:\n    errors.append('Invalid target_type')\n\nfor source in config['sources']:\n    if not source.endswith('.cpp'):\n        errors.append(f'Invalid source file: {source} (must end with .cpp)')\n\n# Write Makefile\nwith open('/app/Makefile', 'w') as f:\n    f.write('## Generated Makefile for {config[\"project_name\"]}\\n\\n')\n    f.write(f'PROJECT_NAME = {config[\"project_name\"]}\\n')\n    f.write(f'TARGET_TYPE = {config[\"target_type\"]}\\n')\n    f.write(f'SOURCES = {config[\"sources\"]}\\n')\n    f.write(f'HEADERS = {config[\"headers\"]}\\n')\n    f.write(f'COMPILER = {config[\"compiler\"]}\\n')\n    f.write(f'CXXSTD = {config[\"standard\"]}\\n')\n    f.write(f'OPTIMIZATION = {config[\"optimization\"]}\\n')\n    f.write(f'INCLUDE_DIRS = {config[\"include_dirs\"]}\\n')\n    f.write(f'LIBRARY_DIRS = {config[\"library_dirs\"]}\\n')\n    f.write(f'LIBRARIES = {config[\"libraries\"]}\\n')\n    f.write(f'DEFINES = {config[\"defines\"]}\\n')\n    f.write(f'WARNINGS = {config[\"warnings\"]}\\n')\n    f.write(f'OUTPUT_DIR = {config[\"output_dir\"]}\\n')\n    f.write(f'CLEAN_PATTERNS = {config[\"clean_patterns\"]}\\n\\n')\n    f.write('ifeq ($(OPTIMIZATION), debug)\\n')\n    f.write('CFLAGS += -g\\n')\n    f.write('else\\n')\n    f.write('CFLAGS += -O2\\n')\n    f.write('endif\\n\\n')\n    f.write('all: $(PROJECT_NAME)\\n\\n')\n    f.write('$(PROJECT_NAME): $(SOURCES:.cpp=.o)\\n')\n    f.write('\\t$(COMPILER) $(CFLAGS) $(CXXSTD) $(DEFINES) -I$(INCLUDE_DIRS) -L$(LIBRARY_DIRS) -o $@ $^ $(LIBRARIES)\\n\\n')\n    f.write('%\\.o: \\.cpp\\n')\n    f.write('\\t$(COMPILER) $(CFLAGS) $(CXXSTD) $(DEFINES) -I$(INCLUDE_DIRS) -c $< -o $@\\n\\n')\n    f.write('clean:\\n')\n    f.write('\\trm -f $(CLEAN_PATTERNS)\\n\\n')\n    f.write('.PHONY: all clean\\n')\n\n# Write test program\nwith open('/app/test_program.cpp', 'w') as f:\n    f.write('#include <iostream>\\n#include \"include/math.h\"\\n\\n#define DEBUG 1\\n\\nint main() {\\n    std::cout << \"Test program for {config[\"project_name\"]}\\n\";\\n    std::cout << \"Using define: DEBUG = \" << DEBUG << std::endl;\\n    return 0;\\n}\\n\\n# Write generation report\\nreport = {\\n    \"status\": \"success\" if len(errors) == 0 else \"failure\",\\n    \"errors\": errors,\\n    \"generated_targets\": [\"Makefile\", \"test_program.cpp\"],\\n    \"variables_defined\": [\"PROJECT_NAME\", \"TARGET_TYPE\", \"SOURCES\", \"HEADERS\", \"COMPILER\", \"CXXSTD\", \"OPTIMIZATION\", \"INCLUDE_DIRS\", \"LIBRARY_DIRS\", \"LIBRARIES\", \"DEFINES\", \"WARNINGS\", \"OUTPUT_DIR\", \"CLEAN_PATTERNS\"],\\n    \"validation_passed\": len(errors) == 0\\n}\\n\\nwith open('/app/generation_report.json', 'w') as f:\\n    json.dump(report, f, indent=4)\\nEOF\n"]
