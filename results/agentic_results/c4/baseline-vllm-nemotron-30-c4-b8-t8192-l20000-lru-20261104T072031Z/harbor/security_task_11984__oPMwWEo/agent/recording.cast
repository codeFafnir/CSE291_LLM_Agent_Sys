[465.636242, "i", "echo \"import requests\\nimport json\\n\\n# Configuration\\nVULNERABLE_APP_URL = 'http://localhost:5000'\\nFIXED_APP_URL = 'http://localhost:5000'\\n\\n# Test credentials\\nTESTUSER = 'testuser'\\nTESTPASS = 'password123'\\n\\n# Security report\\nsecurity_report = {\\n    'vulnerabilities_found': 0,\\n    'exploits_successful_before_fix': False,\\n    'exploits_successful_after_fix': False,\\n    'vulnerability_details': []\\n}\\n\" > exploit_test.py\n"]
[465.638253, "o", "echo \"import requests\\nimport json\\n\\n# Configuration\\nVULNERABLE_APP_URL = 'http://localhost:5000'\\nFIXED_APP_URL = 'http://localhost:5000'\\n\\n# Test credentials\\nTESTUSER = 'testuser'\\nTESTPASS = 'password123'\\n\\n# Security report\\nsecurity_report = {\\n    'vulnerabilities_found': 0,\\n    'exploits_successful_before_fix': False,\\n    'exploits_successful_after_fix': False,\\n    'vulnerability_details': []\\n}\\n\" > exploit_test.py\r\n\u001b[?2004l\r"]
