[42.535448, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <title>Dashboard</title>\r\n</head>\r\n<body>\r\n    <h1>Welcome, {{ username }}</h1>\r\n    <p><a href=\"/logout\">Logout</a></p>\r\n    \r\n    <h2>Your Notes</h2>\r\n    <ul>\r\n    {% for note in user_notes %}\r\n        <li><a href=\"/note/{{ note[0] }}\">{{ note[2] }}</a></li>\r\n    {% endfor %}\r\n    </ul>\r\n    \r\n    <h2>Public Notes</h2>\r\n    <ul>\r\n    {% for note in public_notes %}\r\n        <li><a href=\"/note/{{ note[0] }}\">{{ note[2] }}</a></li>\r\n    {% endfor %}\r\n    </ul>\r\n    \r\n    <p><a href=\"/create\">Create New Note</a></p>\r\n    <p><a href=\"/search\">Search Notes</a></p>\r\n    <p><a href=\"/upload\">Upload File</a></p>\r\n    <p><a href=\"/profile\">View Profile</a></p>\r\n</body>\r\n</html>"]
