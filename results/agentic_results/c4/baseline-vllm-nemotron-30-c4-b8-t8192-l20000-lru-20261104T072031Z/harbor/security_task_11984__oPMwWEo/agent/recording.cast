[664.261878, "o", "def test_path_traversal(url):\r\n\u001b[?2004l\r\u001b[?2004h"]
[664.261927, "o", "> "]
[664.262107, "o", "    \"\"\"Test for path traversal vulnerability.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[664.262159, "o", "> "]
[664.262283, "o", "    payload = \"../../secret.txt\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[664.262331, "o", "> "]
[664.262598, "o", "    response = requests.get(f\"{url}/download\", params={\"file\": payload})\r\n\u001b[?2004l\r"]
[664.262646, "o", "\u001b[?2004h> "]
[664.262795, "o", "    if 'SECRET_DATA' in response.text:\r\n\u001b[?2004l\r"]
