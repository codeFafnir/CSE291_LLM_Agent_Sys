[342.274265, "i", "cat << EOF >> fixed_app.py\n@app.route('/upload', methods=['GET', 'POST'])\ndef upload():\n    \"\"\"File upload endpoint - SECURE version.\"\"\"\n    if 'user_id' not in session:\n        return redirect(url_for('login'))\n\n    if request.method == 'POST':\n        file = request.files['file']\n        if file:\n            # SECURE: Validate and sanitize filename\n            filename = secure_filename(file.filename)\n            filepath = os.path.join('/app/uploads', filename)\n\n            # Ensure the file is not attempting to traverse directories\n            if os.path.isabs(filename) or '..' in filename:\n                return \"Invalid filename\", 400\n\n            file.save(filepath)\n            return f\"File uploaded successfully to {filepath}\"\n\n    return render_template('upload.html')\nEOF\n"]
