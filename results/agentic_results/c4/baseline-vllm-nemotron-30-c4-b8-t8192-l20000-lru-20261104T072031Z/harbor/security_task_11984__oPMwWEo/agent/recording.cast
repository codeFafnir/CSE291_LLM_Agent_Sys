[19.918023, "o", "#!/usr/bin/env python3\r\n\"\"\"\r\nVULNERABLE NOTE-TAKING APPLICATION\r\nDO NOT USE IN PRODUCTION - FOR SECURITY TRAINING ONLY\r\n\"\"\"\r\n\r\nfrom flask import Flask, request, render_template, redirect, url_for, session, send_file\r\nimport sqlite3\r\nimport os\r\nimport json\r\n\r\napp = Flask(__name__)\r\napp.secret_key = \"supersecretkey123\"  # Hardcoded secret\r\n\r\n# Database setup\r\nDB_PATH = \"/app/data/notes.db\"\r\n\r\ndef init_db():\r\n    \"\"\"Initialize the database with sample data.\"\"\"\r\n    conn = sqlite3.connect(DB_PATH)\r\n    cursor = conn.cursor()\r\n    \r\n    cursor.execute('''\r\n        CREATE TABLE IF NOT EXISTS users (\r\n            id INTEGER PRIMARY KEY,\r\n            username TEXT UNIQUE,\r\n            password TEXT,\r\n            is_admin INTEGER DEFAULT 0\r\n        )\r\n    ''')\r\n    \r\n    cursor.execute('''\r\n        CREATE TABLE IF NOT EXISTS notes (\r\n            id INTEGER PRIMARY KEY,\r\n            user_id INTEGER,\r\n            title TEXT,\r\n            content TEXT,\r\n            is_public INTEGER DEFAULT 0,\r\n            FOREIGN KEY(user_id) REFERENCES users(id)\r\n        )\r\n    ''')\r\n    \r\n    # Add sample users if not exists\r\n    cursor.execute(\"SELECT COUNT(*) FROM users\")\r\n    if cursor.fetchone()[0] == 0:\r\n        cursor.execute(\"INSERT INTO users (username, password, is_admin) VALUES ('admin', 'admin123', 1)\")\r\n        cursor.execute(\"INSERT INTO users (username, password) VALUES ('testuser', 'password123')\")\r\n        cursor.execute(\"INSERT INTO users (username, password) VALUES ('alice', 'alicepass')\")\r\n    \r\n    # Add sample notes\r\n    cursor.execute(\"SELECT COUNT(*) FROM notes\")\r\n    if cursor.fetchone()[0] == 0:\r\n        cursor.execute(\"INSERT INTO notes (user_id, title, content, is_public) VALUES (1, 'Admin Note', 'Secret admin information', 0)\")\r\n        cursor.execute(\"INSERT INTO notes (user_id, title, content, is_public) VALUES (2, 'Test Note', 'This is a test note', 1)\")\r\n        cursor.execute(\"INSERT INTO notes (user_id, title, content, is_public) VALUES (3, 'Alice Note', 'Personal note for Alice', 0)\")\r\n    \r\n    conn.commit()\r\n    conn.close()\r\n\r\n# Initialize database on startup\r\ninit_db()\r\n\r\ndef get_db():\r\n    \"\"\"Get database connection.\"\"\"\r\n    return sqlite3.connect(DB_PATH)\r\n\r\n@app.route('/')\r\ndef index():\r\n    \"\"\"Home page.\"\"\"\r\n    return render_template('index.html')\r\n\r\n@app.route('/login', methods=['GET', 'POST'])\r\ndef login():\r\n    \"\"\"Login endpoint - VULNERABLE to SQL injection.\"\"\"\r\n    if request.method == 'POST':\r\n        username = request.form['username']\r\n        password = request.form['password']\r\n        \r\n        conn = get_db()\r\n        cursor = conn.cursor()\r\n        \r\n        # VULNERABILITY: SQL injection via string concatenation\r\n        query = f\"SELECT * FROM users WHERE username='{username}' AND password='{password}'\"\r\n        cursor.execute(query)\r\n        user = cursor.fetchone()\r\n        \r\n        conn.close()\r\n        \r\n        if user:\r\n            session['user_id'] = user[0]\r\n            session['username'] = user[1]\r\n            session['is_admin'] = user[3]\r\n            return redirect(url_for('dashboard'))\r\n        else:\r\n            return \"Invalid credentials\", 401\r\n    \r\n    return render_template('login.html')\r\n\r\n@app.route('/dashboard')\r\ndef dashboard():\r\n    \"\"\"User dashboard.\"\"\"\r\n    if 'user_id' not in session:\r\n        return redirect(url_for('login'))\r\n    "]
[19.918092, "o", "\r\n    conn = get_db()\r\n    cursor = conn.cursor()\r\n    \r\n    # Get user's notes\r\n    user_id = session['user_id']\r\n    cursor.execute(f\"SELECT * FROM notes WHERE user_id={user_id}\")\r\n    user_notes = cursor.fetchall()\r\n    \r\n    # Get public notes\r\n    cursor.execute(\"SELECT * FROM notes WHERE is_public=1\")\r\n    public_notes = cursor.fetchall()\r\n    \r\n    conn.close()\r\n    \r\n    return render_template('dashboard.html', \r\n                          user_notes=user_notes, \r\n                          public_notes=public_notes,\r\n                          username=session['username'])\r\n\r\n@app.route('/note/<int:note_id>')\r\ndef view_note(note_id):\r\n    \"\"\"View a specific note - VULNERABLE to IDOR.\"\"\"\r\n    conn = get_db()\r\n    cursor = conn.cursor()\r\n    \r\n    # VULNERABILITY: Insecure Direct Object Reference\r\n    # No check if user has permission to view this note\r\n    cursor.execute(f\"SELECT * FROM notes WHERE id={note_id}\")\r\n    note = cursor.fetchone()\r\n    \r\n    conn.close()\r\n    \r\n    if note:\r\n        return render_template('note.html', note=note)\r\n    else:\r\n        return \"Note not found\", 404\r\n\r\n@app.route('/create', methods=['GET', 'POST'])\r\ndef create_note():\r\n    \"\"\"Create a new note.\"\"\"\r\n    if 'user_id' not in session:\r\n        return redirect(url_for('login'))\r\n    \r\n    if request.method == 'POST':\r\n        title = request.form['title']\r\n        content = request.form['content']\r\n        is_public = 1 if 'is_public' in request.form else 0\r\n        \r\n        conn = get_db()\r\n        cursor = conn.cursor()\r\n        \r\n        # VULNERABILITY: SQL injection in INSERT\r\n        query = f\"INSERT INTO notes (user_id, title, content, is_public) VALUES ({session['user_id']}, '{title}', '{content}', {is_public})\"\r\n        cursor.execute(query)"]
[19.91841, "o", "\r\n        conn.commit()\r\n        conn.close()\r\n        \r\n        return redirect(url_for('dashboard'))\r\n    \r\n    return render_template('create_note.html')\r\n\r\n@app.route('/search')\r\ndef search():\r\n    \"\"\"Search notes - VULNERABLE to SQL injection.\"\"\"\r\n    query = request.args.get('q', '')\r\n    \r\n    conn = get_db()\r\n    cursor = conn.cursor()\r\n    \r\n    # VULNERABILITY: SQL injection in search\r\n    sql = f\"SELECT * FROM notes WHERE title LIKE '%{query}%' OR content LIKE '%{query}%'\"\r\n    cursor.execute(sql)\r\n    results = cursor.fetchall()\r\n    \r\n    conn.close()\r\n    \r\n    return render_template('search.html', results=results, query=query)\r\n\r\n@app.route('/upload', methods=['GET', 'POST'])\r\ndef upload():\r\n    \"\"\"File upload endpoint - VULNERABLE to path traversal.\"\"\"\r\n    if 'user_id' not in session:\r\n        return redirect(url_for('login'))\r\n    \r\n    if request.method == 'POST':\r\n        file = request.files['file']\r\n        if file:\r\n            # VULNERABILITY: Path traversal in filename\r\n            filename = file.filename\r\n            filepath = os.path.join(\"/app/uploads\", filename)\r\n            file.save(filepath)\r\n            return f\"File uploaded successfully to {filepath}\"\r\n    \r\n    return render_template('upload.html')\r\n\r\n@app.route('/download')\r\ndef download():\r\n    \"\"\"File download endpoint - VULNERABLE to path traversal.\"\"\"\r\n    filename = request.args.get('file', '')\r\n    \r\n    # VULNERABILITY: Path traversal - no validation\r\n    filepath = os.path.join(\"/app/uploads\", filename)\r\n    \r\n    if os.path.exists(filepath):\r\n        return send_file(filepath, as_attachment=True)\r\n    else:\r\n        return \"File not found\", 404\r\n\r\n@app.route('/profile')\r\ndef profile():\r\n    \"\"\"User profile page.\"\"\"\r\n    if 'user_id' not in session:\r\n        return redirect(url_for('login'))\r\n    \r\n    # Get username from session (could be tampered with)\r\n    username = session.get('username', '')\r\n    \r\n    # VULNERABILITY: Reflected XSS in username display\r\n    return f\"\"\"\r\n    <html>\r\n    <body>\r\n        <h1>Profile for {username}</h1>\r\n        <p>Welcome to your profile!</p>\r\n        <a href=\"/dashboard\">Back to Dashboard</a>\r\n    </body>\r\n    </html>\r\n    \"\"\"\r\n\r\n@app.route('/logout')\r\ndef logout():\r\n    \"\"\"Logout user.\"\"\"\r\n    session.clear()\r\n    return redirect(url_for('index'))\r\n\r\nif __name__ == '__main__':\r\n    # Create uploads directory if it doesn't exist\r\n    os.makedirs(\"/app/uploads\", exist_ok=True)\r\n    \r\n    # Write a secret file for path traversal testing\r\n    with open(\"/app/secret.txt\", \"w\") as f:\r\n        f.write(\"SECRET_DATA: This should not be accessible via download endpoint\\n\")\r\n    \r\n    app.run(host='0.0.0.0', port=5000, debug=True)"]
