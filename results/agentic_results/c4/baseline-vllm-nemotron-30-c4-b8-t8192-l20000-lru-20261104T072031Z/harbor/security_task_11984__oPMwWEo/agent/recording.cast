[184.816486, "i", "echo \"@app.route('/login', methods=['GET', 'POST'])\\ndef login():\\n    \\\"\\\"\\\"Login endpoint - SECURE version.\\\"\\\"\\\"\\n    if request.method == 'POST':\\n        username = request.form['username']\\n        password = request.form['password']\\n\\n        conn = get_db()\\n        cursor = conn.cursor()\\n\\n        # SECURE: Use parameterized queries\\n        query = \\\"SELECT * FROM users WHERE username = ? AND password = ?\\\"\\n        cursor.execute(query, (username, password))\\n        user = cursor.fetchone()\\n\\n        conn.close()\\n\\n        if user:\\n            session['user_id'] = user[0]\\n            session['username'] = user[1]\\n            session['is_admin'] = user[3]\\n            return redirect(url_for('dashboard'))\\n        else:\\n            return \\\"Invalid credentials\\\", 401\\n\\n    return render_template('login.html')\\n\" >> fixed_app.py\n"]
[184.819713, "o", "echo \"@app.route('/login', methods=['GET', 'POST'])\\ndef login():\\n    \\\"\\\"\\\"Login endpoint - SECURE version.\\\"\\\"\\\"\\n    if request.method == 'POST':\\n        username = request.form['username']\\n        password = request.form['password']\\n\\n        conn = get_db()\\n        cursor = conn.cursor()\\n\\n        # SECURE: Use parameterized queries\\n        query = \\\"SELECT * FROM users WHERE username = ? AND password = ?\\\"\\n        cursor.execute(query, (username, password))\\n        user = cursor.fetchone()\\n\\n        conn.close()\\n\\n        if user:\\n            session['user_id'] = user[0]\\n            session['username'] = user[1]\\n            session['is_admin'] = user[3]\\n            return redirect(url_for('dashboard'))\\n        else:\\n            return \\\"Invalid credentials\\\", 401\\n\\n    return render_template('login.html')\\n\" >> fixed_app.py\r\n\u001b[?2004l\r"]
[184.819994, "o", "\u001b[?2004hroot@9dad68e64df9:/app# "]
[199.756223, "i", "echo \"@app.route('/dashboard')\\ndef dashboard():\\n    \\\"\\\"\\\"User dashboard - SECURE version.\\\"\\\"\\\"\\n    if 'user_id' not in session:\\n        return redirect(url_for('login'))\\n\\n    conn = get_db()\\n    cursor = conn.cursor()\\n\\n    # SECURE: Use parameterized queries\\n    user_id = session['user_id']\\n    cursor.execute(\\\"SELECT * FROM notes WHERE user_id = ?\\\", (user_id,))\\n    user_notes = cursor.fetchall()\\n\\n    cursor.execute(\\\"SELECT * FROM notes WHERE is_public = 1\\\")\\n    public_notes = cursor.fetchall()\\n\\n    conn.close()\\n\\n    return render_template('dashboard.html', user_notes=user_notes, public_notes=public_notes, username=session['username'])\\n\" >> fixed_app.py\n"]
[199.759145, "o", "echo \"@app.route('/dashboard')\\ndef dashboard():\\n    \\\"\\\"\\\"User dashboard - SECURE version.\\\"\\\"\\\"\\n    if 'user_id' not in session:\\n        return redirect(url_for('login'))\\n\\n    conn = get_db()\\n    cursor = conn.cursor()\\n\\n    # SECURE: Use parameterized queries\\n    user_id = session['user_id']\\n    cursor.execute(\\\"SELECT * FROM notes WHERE user_id = ?\\\", (user_id,))\\n    user_notes = cursor.fetchall()\\n\\n    cursor.execute(\\\"SELECT * FROM notes WHERE is_public = 1\\\")\\n    public_notes = cursor.fetchall()\\n\\n    conn.close()\\n\\n    return render_template('dashboard.html', user_notes=user_notes, public_notes=public_notes, username=session['username'])\\n\" >> fixed_app.py\r\n\u001b[?2004l\r"]
