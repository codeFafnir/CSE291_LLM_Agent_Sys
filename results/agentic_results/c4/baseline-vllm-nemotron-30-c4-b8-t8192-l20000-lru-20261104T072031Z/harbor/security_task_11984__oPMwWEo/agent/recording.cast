[44.539827, "o", "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <title>Login</title>\r\n</head>\r\n<body>\r\n    <h1>Login</h1>\r\n    <form method=\"POST\">\r\n        <label>Username:</label>\r\n        <input type=\"text\" name=\"username\"><br>\r\n        <label>Password:</label>\r\n        <input type=\"password\" name=\"password\"><br>\r\n        <input type=\"submit\" value=\"Login\">\r\n    </form>\r\n    <p>Try: testuser / password123</p>\r\n</body>\r\n</html>"]
