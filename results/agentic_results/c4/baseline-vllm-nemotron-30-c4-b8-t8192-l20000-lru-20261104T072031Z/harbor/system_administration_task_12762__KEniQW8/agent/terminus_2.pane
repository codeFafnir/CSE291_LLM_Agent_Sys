[?2004l[?2004h> 
[?2004lm[?2004h> class LogMonitorHandler(FileSystemEventHandler):
[?2004lu[?2004h>     def __init__(self):
[?2004l[?2004h>         self.patterns = {
[?2004l[?2004h>             "ERROR": re.compile(r"ERROR", re.IGNORECASE),
