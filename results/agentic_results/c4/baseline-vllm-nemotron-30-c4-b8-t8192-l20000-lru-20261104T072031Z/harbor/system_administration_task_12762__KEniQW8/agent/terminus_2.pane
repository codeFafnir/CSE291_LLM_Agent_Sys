[?2004l[?2004h> 
[?2004l[?2004h>     def process_file(self, file_path):
[?2004l[?2004h>         if not file_path.endswith(".log"):
[?2004l[?2004h>             return
[?2004l[?2004h> 
[?2004l[?2004h>         if os.path.getsize(file_path) > 100 * 1024 * 1024:
[?2004l[?2004h>             return
[?2004l[?2004h> 
[?2004l[?2004h>         if file_path not in self.state:
[?2004l[?2004h>             self.state[file_path] = {"last_position": 0, "lines_processed": 0, "errors": 0, "warnings": 0, "auth_failures": 0, "ips_found": []}
[?2004l[?2004h>         else:
[?2004l[?2004h>             last_position = self.state[file_path]["last_position"]
[?2004l[?2004h>             with open(file_path, "r") as f:
[?2004l[?2004h>                 f.seek(last_position)
[?2004l[?2004h>                 lines = f.readlines()
[?2004l[?2004h>                 self.state[file_path]["lines_processed"] += len(lines)
[?2004l[?2004h>                 self.state[file_path]["last_position"] = f.tell()
[?2004l[?2004h> 
[?2004l[?2004h>                 for line in lines:
[?2004l[?2004h>                     for pattern, regex in self.patterns.items():
[?2004l[?2004h>                         if regex.search(line):
[?2004l[?2004h>                             if pattern == "ERROR":
[?2004l[?2004h>                                 self.state[file_path]["errors"] += 1
[?2004l[?2004h>                             elif pattern == "WARNING":
[?2004l[?2004h>                                 self.state[file_path]["warnings"] += 1
[?2004l[?2004h>                             elif pattern == "authentication failed":
[?2004l[?2004h>                                 self.state[file_path]["auth_failures"] += 1
[?2004l[?2004h>                             elif pattern == "IP":
[?2004l[?2004h>                                 ip = regex.search(line).group()
[?2004l[?2004h>                                 if ip not in self.state[file_path]["ips_found"]:
[?2004l[?2004h>                                     self.state[file_path]["ips_found"].append(ip)
[?2004l[?2004h> 
[?2004l[?2004h>         self.save_state()
[?2004l[?2004h> 
[?2004l[?2004h>     def generate_report(self):
[?2004l[?2004h>         report = {
[?2004l[?2004h>             "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
[?2004l[?2004h>             "scan_duration_seconds": 300,
[?2004l[?2004h>             "files_monitored": list(self.state.keys()),
[?2004l[?2004h>             "statistics": {
[?2004l[?2004h>                 "total_lines_processed": sum(stats["lines_processed"] for stats in self.state.values()),
[?2004l[?2004h>                 "total_errors": sum(stats["errors"] for stats in self.state.values()),
[?2004l[?2004h>                 "total_warnings": sum(stats["warnings"] for stats in self.state.values()),
[?2004l[?2004h>                 "total_auth_failures": sum(stats["auth_failures"] for stats in self.state.values()),
[?2004l[?2004h>                 "unique_ips_found": len(set(ip for stats in self.state.values() for ip in stats["ips_found"]))
[?2004l[?2004h>             },
[?2004l[?2004h>             "file_details": {
[?2004l[?2004h>                 file_path: {
[?2004l[?2004h>                     "lines_processed": stats["lines_processed"],
[?2004l[?2004h>                     "errors": stats["errors"],
[?2004l[?2004h>                     "warnings": stats["warnings"],
[?2004l[?2004h>                     "auth_failures": stats["auth_failures"],
[?2004l[?2004h>                     "ips_found": stats["ips_found"]
[?2004l[?2004h>                 }
[?2004l[?2004h>                 for file_path, stats in self.state.items()
[?2004l[?2004h>             },
[?2004l[?2004h>             "alerts": [
[?2004l[?2004h>                 {
[?2004l[?2004h>                     "type": "high_error_rate",
[?2004l[?2004h>                     "message": "Error rate exceeds 10% of total lines in any file",
[?2004l[?2004h>                     "threshold_exceeded": any(stats["errors"] / stats["lines_processed"] > 0.1 for stats in self.state.values() if stats["lines_processed"] > 0)
[?2004l[?2004h>                 },
[?2004l[?2004h>                 {
