[75.973352, "o", "                {\r\n\u001b[?2004l\r"]
[75.973394, "o", "\u001b[?2004h> "]
[75.97357, "o", "                    \"type\": \"auth_failure_spike\",\r\n\u001b[?2004l\r"]
[75.973609, "o", "\u001b[?2004h> "]
[75.973922, "o", "                    \"message\": \"More than 5 authentication failures found in any 5-minute period\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.973962, "o", "> "]
[75.974298, "o", "                    \"threshold_exceeded\": any(stats[\"auth_failures\"] > 5 for stats in self.state.values())\r\n\u001b[?2004l\r"]
[75.974333, "o", "\u001b[?2004h> "]
[75.97441, "o", "                }\r\n\u001b[?2004l\r"]
[75.974479, "o", "\u001b[?2004h> "]
[75.974581, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.974627, "o", "        }\r\n\u001b[?2004l\r"]
[75.974709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.974912, "o", "        with open(\"reports/log_summary.json\", \"w\") as f:\r\n\u001b[?2004l\r"]
[75.974972, "o", "\u001b[?2004h> "]
[75.975075, "o", "            json.dump(report, f)\r\n\u001b[?2004l\r"]
[75.975116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.975194, "o", "\u001b[?2004h> "]
[75.975264, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[75.975312, "o", "\u001b[?2004h> "]
[75.975457, "o", "    event_handler = LogMonitorHandler()\r\n\u001b[?2004l\r"]
[75.975498, "o", "\u001b[?2004h> "]
[75.975604, "o", "    observer = Observer()\r\n\u001b[?2004l\r"]
[75.975643, "o", "\u001b[?2004h> "]
[75.975875, "o", "    observer.schedule(event_handler, \"logs/webserver\", recursive=True)\r\n\u001b[?2004l\r"]
[75.975925, "o", "\u001b[?2004h> "]
[75.976173, "o", "    observer.schedule(event_handler, \"logs/database\", recursive=True)\r\n\u001b[?2004l\r"]
[75.976215, "o", "\u001b[?2004h> "]
[75.976299, "o", "    observer.start()\r\n\u001b[?2004l\r"]
[75.97635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.976393, "o", "> "]
[75.976495, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.976544, "o", "        while True:\r\n\u001b[?2004l\r"]
[75.976585, "o", "\u001b[?2004h> "]
[75.976698, "o", "            time.sleep(30)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.976738, "o", "> "]
[75.976894, "o", "            event_handler.generate_report()\r\n\u001b[?2004l\r"]
[75.976933, "o", "\u001b[?2004h> "]
[75.977046, "o", "    except KeyboardInterrupt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.977119, "o", "> "]
[75.977188, "o", "        observer.stop()\r\n\u001b[?2004l\r"]
[75.977226, "o", "\u001b[?2004h> "]
[75.977324, "o", "        observer.join()\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.977365, "o", "> "]
[75.977498, "o", "        event_handler.save_state()\r\n\u001b[?2004l\r"]
[75.977561, "o", "\u001b[?2004h> "]
