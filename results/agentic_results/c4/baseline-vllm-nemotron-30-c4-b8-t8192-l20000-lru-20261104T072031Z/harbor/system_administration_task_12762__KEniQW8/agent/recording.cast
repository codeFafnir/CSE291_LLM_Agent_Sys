[74.949602, "i", "echo '[Unit]\nDescription=Log Monitoring Service for Security Analysis\n\n[Service]\nType=simple\nUser=nobody\nWorkingDirectory=/app\nExecStart=/usr/bin/python3 /app/log_watcher.py\nRestart=on-failure\nRestartSec=10\nStandardOutput=syslog\nStandardError=syslog\n\n[Install]\nWantedBy=multi-user.target' > log-monitor.service\n"]
[74.94981, "o", "echo '[Unit]\r\n\u001b[?2004l\r"]
[74.949856, "o", "\u001b[?2004h"]
[74.949931, "o", "> "]
[74.950127, "o", "Description=Log Monitoring Service for Security Analysis\r\n\u001b[?2004l\r"]
[74.950198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.950231, "o", "\u001b[?2004h> "]
[74.95055, "o", "[Service]\r\n\u001b[?2004l\r\u001b[?2004h> Type=simple\r\n\u001b[?2004l\r\u001b[?2004h> User=nobody\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.950649, "o", "WorkingDirectory=/app\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.95071, "o", "> "]
[74.950956, "o", "ExecStart=/usr/bin/python3 /app/log_watcher.py"]
[74.951007, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
