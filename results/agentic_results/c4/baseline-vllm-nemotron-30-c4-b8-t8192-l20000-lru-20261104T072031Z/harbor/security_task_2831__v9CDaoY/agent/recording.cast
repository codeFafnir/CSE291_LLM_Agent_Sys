[31.254022, "i", "python3 -c \"import base64, hashlib, json, sys; lines = sys.stdin.read().splitlines(); cleaned_lines = []; infected_lines = []; total_lines = len(lines); injections_found = 0; for i, line in enumerate(lines):\\n    cleaned_line = line\\n    for j in range(len(line)):\\n        if line[j] == '$' and j + 1 < len(line) and line[j+1] == '(':\\n            start = j\\n            end = j\\n            while end < len(line) and line[end] in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=':\\n                end += 1\\n            b64_str = line[start:end]\\n            try:\\n                decoded = base64.b64decode(b64_str).decode('utf-8', errors='ignore')\\n                if len(b64_str) > 20 and 'eval(' in decoded.lower():\\n                    cleaned_line = line[:start] + '[REDACTED_B64_INJECTION]' + line[end:]\\n                    injections_found += 1\\n                    infected_lines.append(i + 1)\\n                    break\\n            except:\\n                pass\\n    cleaned_lines.append(cleaned_line)\\n; with open('/app/cleaned_web_access.log', 'w') as f:\\n    f.writelines(cleaned_lines)\\n; with open('/app/security_report.json', 'w') as f:\\n    json.dump({\\n        'total_lines': total_lines,\\n        'injections_found': injections_found,\\n        'infected_lines': infected_lines,\\n        'cleaned_file_hash': hashlib.sha256(open('/app/cleaned_web_access.log', 'rb').read()).hexdigest()\\n    }, f)\\n\" < /app/web_access.log\n"]
