[?2004limport asyncio
import aiofiles
import os
from collections import defaultdict
import time

# Global variables that may cause issues
file_contents_cache = []  # SUSPECT: Memory leak candidate
word_counts = defaultdict(int)
processed_files = 0

async def process_file(filepath):
    """Process a single file and count words."""
    global word_counts, processed_files, file_contents_cache
    
    # SUSPECT: Opening files without proper resource management
    f = await aiofiles.open(filepath, mode='r')
    content = await f.read()
    await f.close()
    
    # SUSPECT: Storing all content in memory
    file_contents_cache.append(content)
    
    # SUSPECT: Inefficient word splitting and counting
    words = content.split()
    for word in words:
        word = word.lower().strip('.,!?;:"\'()[]{}')
        if word:
            word_counts[word] += 1
    
    processed_files += 1
    if processed_files % 20 == 0:
        print(f"Processed {processed_files} files...")

async def main():
    """Main processing function."""
    start_time = time.time()
    
    input_dir = '/app/inputs'
    if not os.path.exists(input_dir):
        print(f"Input directory {input_dir} does not exist")
        return
    
    # Get all text files
    files = []
    for root, dirs, filenames in os.walk(input_dir):
        for filename in filenames:
            if filename.endswith('.txt'):
                files.append(os.path.join(root, filename))
    
    print(f"Found {len(files)} files to process")
    
    # SUSPECT: Creating too many concurrent tasks
    tasks = []
    for filepath in files:
        task = asyncio.create_task(process_file(filepath))
        tasks.append(task)
    
    # SUSPECT: No limit on concurrent I/O operations
    await asyncio.gather(*tasks)
    
    # Get top 10 words
    top_words = sorted(word_counts.items(), key=lambda x: x[1], reverse=True)[:10]
    
    # Ensure output directory exists
    output_dir = '/app/output'
    os.makedirs(output_dir, exist_ok=True)
    
    # Write results
    output_file = os.path.join(output_dir, 'top_words.txt')
    with open(output_file, 'w') as f:
        for word, count in top_words:
            f.write(f"{word}: {count}\n")
    
    elapsed = time.time() - start_time
    print(f"Processing completed in {elapsed:.2f} seconds")
    print(f"Top words saved to {output_file}")
    
    # SUSPECT: Not clearing cache (memory leak)
    return top_words

if __name__ == '__main__':
    asyncio.run(main())[?2004h(venv) root@acbbc0070ed1:/app# cp /app/word_counter.py /app/fixed_word_counter.py
