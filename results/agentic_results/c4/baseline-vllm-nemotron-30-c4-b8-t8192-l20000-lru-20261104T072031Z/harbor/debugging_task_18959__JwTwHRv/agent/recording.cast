[219.02251, "o", "\u001b[?2004h(venv) root@acbbc0070ed1:/app# "]
[242.929126, "i", "cat /app/word_counter.py\n"]
[242.929368, "o", "cat /app/word_counter.py\r\n\u001b[?2004l\r"]
[242.930527, "o", "import asyncio\r\nimport aiofiles\r\nimport os\r\nfrom collections import defaultdict\r\nimport time\r\n\r\n# Global variables that may cause issues\r\nfile_contents_cache = []  # SUSPECT: Memory leak candidate\r\nword_counts = defaultdict(int)\r\nprocessed_files = 0\r\n\r\nasync def process_file(filepath):\r\n    \"\"\"Process a single file and count words.\"\"\"\r\n    global word_counts, processed_files, file_contents_cache\r\n    \r\n    # SUSPECT: Opening files without proper resource management\r\n    f = await aiofiles.open(filepath, mode='r')\r\n    content = await f.read()\r\n    await f.close()\r\n    \r\n    # SUSPECT: Storing all content in memory\r\n    file_contents_cache.append(content)\r\n    \r\n    # SUSPECT: Inefficient word splitting and counting\r\n    words = content.split()\r\n    for word in words:\r\n        word = word.lower().strip('.,!?;:\"\\'()[]{}')\r\n        if word:\r\n            word_counts[word] += 1\r\n    \r\n    processed_files += 1\r\n    if processed_files % 20 == 0:\r\n        print(f\"Processed {processed_files} files...\")\r\n\r\nasync def main():\r\n    \"\"\"Main processing function.\"\"\"\r\n    start_time = time.time()\r\n    \r\n    input_dir = '/app/inputs'\r\n    if not os.path.exists(input_dir):\r\n        print(f\"Input directory {input_dir} does not exist\")\r\n        return\r\n    \r\n    # Get all text files\r\n    files = []\r\n    for root, dirs, filenames in os.walk(input_dir):\r\n        for filename in filenames:\r\n            if filename.endswith('.txt'):\r\n                files.append(os.path.join(root, filename))\r\n    \r\n    print(f\"Found {len(files)} files to process\")\r\n    \r\n    # SUSPECT: Creating too many concurrent tasks\r\n    tasks = []\r\n    for filepath in files:\r\n        task = asyncio.create_task(process_file(filepath))\r\n        tasks.append(task)\r\n    \r\n    # SUSPECT: No limit on concurrent I/O operations\r\n    await asyncio.gather(*tasks)\r\n    \r\n    # Get top 10 words\r\n    top_words = sorted(word_counts.items(), key=lambda x: x[1], reverse=True)[:10]\r\n    \r\n    # Ensure output directory exists\r\n    output_dir = '/app/output'\r\n    os.makedirs(output_dir, exist_ok=True)\r\n    \r\n    # Write results\r\n    output_file = os.path.join(output_dir, 'top_words.txt')\r\n    with open(output_file, 'w') as f:\r\n        for word, count in top_words:\r\n            f.write(f\"{word}: {count}\\n\")\r\n    \r\n    elapsed = time.time() - start_time\r\n    print(f\"Processing completed in {elapsed:.2f} seconds\")\r\n    print(f\"Top words saved to {output_file}\")\r\n    \r\n    # SUSPECT: Not clearing cache (memory leak)\r\n    return top_words\r\n\r\nif __name__ == '__main__':\r\n    asyncio.run(main())"]
