[?2004hroot@d52bc988c964:/app# echo "import json\nimport numpy as np\n\n# Read parameters from JSON\nwith open('/app/parameters.json', 'r') as f:\n    params = json.load(f)\n\nalpha = params['alpha']\nK = params['K']\ny0 = params['y0']\nt_start = params['t_start']\nt_end = params['t_end']\nnum_steps = params['num_steps']\n\nh = (t_end - t_start) / num_steps\ntimes = [t_start + i * h for i in range(num_steps + 1)]\ny_values = [y0]\n\n# Euler method\nfor i in range(num_steps):\n    y = y_values[-1]\n    dydt = alpha * y * (1 - y / K)\n    y_next = y + h * dydt\n    y_values.append(y_next)\n\n# Save results to CSV\nimport csv\nwith open('/app/output/results.csv', 'w', newline='') as csvfile:\n    writer = csv.writer(csvfile)\n    writer.writerow(['time', 'population'])\n    for t, y in zip(times, y_values):\n        writer.writerow([round(t, 4), round(y, 4)])\n\n# Save summary statistics\nsummary = {\n    'final_population': round(y_values[-1], 4),\n    'max_population': round(max(y_values), 4),\n    'convergence_time': None\n}\n\n# Find convergence time\nfor i, t in enumerate(times):\n    if abs(y_values[i] - K) < 0.01 * K:\n        summary['convergence_time'] = round(t, 4)\n        break\n\nwith open('/app/output/summary.json', 'w') as f:\n    json.dump(summary, f)" > /app/solver.py
