[11.290475, "i", "python3 -c \"import base64, hashlib, json, sys; malicious_count = 0; infected_lines = []; total_lines = 0; with open('/app/web_access.log', 'r') as infile, open('/app/cleaned_web_access.log', 'w') as outfile: for line_num, line in enumerate(infile): total_lines += 1; cleaned_line = line; for i in range(0, len(line), 20): substr = line[i:i+20]; try: decoded = base64.b64decode(substr).decode('utf-8', errors='ignore'); if 'eval(' in decoded.lower(): cleaned_line = cleaned_line[:i] + '[REDACTED_B64_INJECTION]' + cleaned_line[i+20:]; malicious_count += 1; infected_lines.append(line_num + 1); break; except: pass; outfile.write(cleaned_line); with open('/app/security_report.json', 'w') as report_file: json.dump({'total_lines': total_lines, 'injections_found': malicious_count, 'infected_lines': infected_lines, 'cleaned_file_hash': hashlib.sha256(open('/app/cleaned_web_access.log', 'rb').read()).hexdigest()}, report_file)\"\n"]
