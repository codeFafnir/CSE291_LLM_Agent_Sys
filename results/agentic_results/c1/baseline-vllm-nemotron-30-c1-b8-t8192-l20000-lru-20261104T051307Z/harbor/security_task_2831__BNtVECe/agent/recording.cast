[30.409806, "i", "echo \"import base64, hashlib, json, sys\\nmalicious_count = 0\\ninfected_lines = []\\ntotal_lines = 0\\nwith open('/app/web_access.log', 'r') as infile, open('/app/cleaned_web_access.log', 'w') as outfile:\\n    for line_num, line in enumerate(infile):\\n        total_lines += 1\\n        cleaned_line = line\\n        for i in range(0, len(line), 20):\\n            substr = line[i:i+20]\\n            try:\\n                decoded = base64.b64decode(substr).decode('utf-8', errors='ignore')\\n                if 'eval(' in decoded.lower():\\n                    cleaned_line = cleaned_line[:i] + '[REDACTED_B64_INJECTION]' + cleaned_line[i+20:]\\n                    malicious_count += 1\\n                    infected_lines.append(line_num + 1)\\n                    break\\n            except:\\n                pass\\n        outfile.write(cleaned_line)\\nwith open('/app/security_report.json', 'w') as report_file:\\n    json.dump({'total_lines': total_lines, 'injections_found': malicious_count, 'infected_lines': infected_lines, 'cleaned_file_hash': hashlib.sha256(open('/app/cleaned_web_access.log', 'rb').read()).hexdigest()}, report_file)\" > /app/clean_log.py\n"]
