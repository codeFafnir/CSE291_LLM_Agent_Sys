[242.37421, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[242.374299, "o", "        # Accumulate gradients\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.374374, "o", "> "]
[242.374539, "o", "        if (batch_idx + 1) % gradient_accumulation_steps == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.374581, "o", "> "]
[242.374685, "o", "            optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.374764, "o", "> "]
[242.374838, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.374913, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.375099, "o", "        running_loss += loss.item() * gradient_accumulation_steps\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.375172, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.375227, "o", "> "]
[242.375354, "o", "    # Compute average training loss for the epoch\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.375401, "o", "> "]
[242.375554, "o", "    avg_train_loss = running_loss / len(train_loader)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.3756, "o", "> "]
[242.375732, "o", "    train_losses.append(avg_train_loss)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.375805, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.375883, "o", "    # Validation phase\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.375974, "o", "> "]
[242.376027, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.376069, "o", "    val_loss = 0.0\r\n\u001b[?2004l\r"]
[242.376104, "o", "\u001b[?2004h> "]
[242.376273, "o", "    correct = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.376328, "o", ">     total = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.376443, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.376703, "o", "        val_dataset = torch.utils.data.TensorDataset(X_val_tensor, y_val_tensor)\r\n\u001b[?2004l\r"]
[242.376756, "o", "\u001b[?2004h> "]
[242.37709, "o", "        val_loader = torch.utils.data.DataLoader(val_dataset, batch_size=batch_size, shuffle=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.377139, "o", "> "]
[242.377266, "o", "        for data, target in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.377352, "o", "> "]
[242.37741, "o", "            output = model(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.377522, "o", "> "]
[242.377599, "o", "            loss = criterion(output, target)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.377643, "o", "> "]
[242.377779, "o", "            val_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.37798, "o", "            predicted = torch.round(torch.sigmoid(output))\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.378075, "o", "> "]
[242.378139, "o", "            total += target.size(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.378255, "o", "> "]
[242.378366, "o", "            correct += (predicted == target).sum().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.37844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.378576, "o", "    avg_val_loss = val_loss / len(val_loader)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.378613, "o", "> "]
[242.378734, "o", "    val_losses.append(avg_val_loss)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.378774, "o", "> "]
[242.378888, "o", "    val_accuracy = correct / total\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.378925, "o", "> "]
[242.379056, "o", "    val_accuracies.append(val_accuracy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.379107, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.379155, "o", "> "]
[242.379273, "o", "    # Update learning rate scheduler\r\n\u001b[?2004l\r"]
[242.379321, "o", "\u001b[?2004h> "]
[242.379434, "o", "cosine_scheduler.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.379605, "o", "    learning_rates.append(optimizer.param_groups[0]['lr'])\r\n\u001b[?2004l\r"]
[242.379661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[242.379705, "o", "\u001b[?2004h> "]
[242.37983, "o", "    # Save results to JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.379994, "o", "    results['final_train_loss'] = train_losses[-1]\r\n\u001b[?2004l\r"]
[242.380032, "o", "\u001b[?2004h> "]
[242.380185, "o", "    results['final_val_loss'] = val_losses[-1]\r\n\u001b[?2004l\r"]
[242.380224, "o", "\u001b[?2004h> "]
[242.380398, "o", "    results['final_val_accuracy'] = val_accuracies[-1]\r\n\u001b[?2004l\r"]
[242.380439, "o", "\u001b[?2004h> "]
[242.380605, "o", "    results['learning_rates'] = learning_rates\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.380639, "o", "> "]
[242.380781, "o", "    results['train_losses'] = train_losses\r\n\u001b[?2004l\r"]
[242.380818, "o", "\u001b[?2004h> "]
[242.380951, "o", "    results['val_losses'] = val_losses\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.380991, "o", "> "]
[242.381138, "o", "    results['val_accuracies'] = val_accuracies\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.381188, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.381228, "o", "> "]
[242.381366, "o", "    # Check if validation accuracy improved\r\n\u001b[?2004l\r"]
[242.381412, "o", "\u001b[?2004h> "]
[242.381548, "o", "    if val_accuracy > best_val_accuracy:\r\n\u001b[?2004l\r"]
[242.381594, "o", "\u001b[?2004h> "]
[242.381718, "o", "        best_val_accuracy = val_accuracy\r\n\u001b[?2004l\r"]
[242.381805, "o", "\u001b[?2004h> "]
[242.381863, "o", "        best_epoch = epoch + 1\r\n\u001b[?2004l\r"]
[242.381905, "o", "\u001b[?2004h> "]
[242.382077, "o", "        results['best_val_accuracy'] = best_val_accuracy\r\n\u001b[?2004l\r"]
[242.382126, "o", "\u001b[?2004h> "]
[242.382254, "o", "        results['best_epoch'] = best_epoch\r\n\u001b[?2004l\r"]
[242.3823, "o", "\u001b[?2004h> "]
[242.382416, "o", "        # Save best model checkpoint\r\n\u001b[?2004l\r"]
[242.382463, "o", "\u001b[?2004h> "]
[242.382683, "o", "        checkpoint_path = os.path.join(checkpoints_dir, 'best_model.pth')\r\n\u001b[?2004l\r"]
[242.38273, "o", "\u001b[?2004h> "]
[242.382831, "o", "        torch.save({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.382922, "o", "            'epoch': epoch + 1,\r\n\u001b[?2004l\r"]
[242.38297, "o", "\u001b[?2004h> "]
[242.383127, "o", "            'model_state': model.state_dict(),\r\n\u001b[?2004l\r"]
[242.383175, "o", "\u001b[?2004h> "]
[242.383342, "o", "            'optimizer_state': optimizer.state_dict(),\r\n\u001b[?2004l\r"]
[242.383389, "o", "\u001b[?2004h> "]
[242.383574, "o", "            'scheduler_state': cosine_scheduler.state_dict(),\r\n\u001b[?2004l\r"]
[242.383622, "o", "\u001b[?2004h> "]
[242.383756, "o", "            'train_loss': train_losses[-1],\r\n\u001b[?2004l\r"]
[242.383804, "o", "\u001b[?2004h> "]
[242.383926, "o", "            'val_loss': val_losses[-1],\r\n\u001b[?2004l\r"]
[242.383973, "o", "\u001b[?2004h> "]
[242.384115, "o", "            'val_accuracy': val_accuracies[-1]\r\n\u001b[?2004l\r"]
[242.384163, "o", "\u001b[?2004h> "]
[242.384263, "o", "        }, checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.384464, "o", "        results['checkpoints_saved'].append(checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.384522, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.384567, "o", "> "]
[242.384687, "o", "    # Save checkpoint every 5 epochs\r\n\u001b[?2004l\r"]
[242.384737, "o", "\u001b[?2004h> "]
[242.38482, "o", "    if (epoch + 1) % 5 == 0:\r\n\u001b[?2004l\r"]
[242.384863, "o", "\u001b[?2004h> "]
[242.385156, "o", "        checkpoint_path = os.path.join(checkpoints_dir, f'checkpoint_epoch_{epoch + 1}.pth')\r\n\u001b[?2004l\r"]
[242.385202, "o", "\u001b[?2004h> "]
[242.385306, "o", "        torch.save({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.3854, "o", "            'epoch': epoch + 1,\r\n\u001b[?2004l\r"]
[242.385448, "o", "\u001b[?2004h> "]
[242.385605, "o", "            'model_state': model.state_dict(),\r\n\u001b[?2004l\r"]
[242.385652, "o", "\u001b[?2004h> "]
[242.385817, "o", "            'optimizer_state': optimizer.state_dict(),\r\n\u001b[?2004l\r"]
[242.385865, "o", "\u001b[?2004h> "]
[242.386051, "o", "            'scheduler_state': cosine_scheduler.state_dict(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.3861, "o", "> "]
[242.386231, "o", "            'train_loss': train_losses[-1],\r\n\u001b[?2004l\r"]
[242.386278, "o", "\u001b[?2004h> "]
[242.386411, "o", "            'val_loss': val_losses[-1],\r\n\u001b[?2004l\r"]
[242.386458, "o", "\u001b[?2004h> "]
[242.386601, "o", "            'val_accuracy': val_accuracies[-1]\r\n\u001b[?2004l\r"]
[242.386647, "o", "\u001b[?2004h> "]
[242.386749, "o", "        }, checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[242.386861, "o", "> "]
[242.386993, "o", "        results['checkpoints_saved'].append(checkpoint_path)\r\n\u001b[?2004l\r"]
[242.387034, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[242.38707, "o", "\u001b[?2004h> "]
[242.387191, "o", "    # Print progress\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.387779, "o", "    print(f'Epoch {epoch + 1}/{total_epochs}, Train Loss: {avg_train_loss:.4f}, Val Loss: {avg_val_loss:.4f}, Val Accuracy: {val_accuracy:.4f}, Learning Rate: {optimizer.param_groups[0]['lr']:.6f}')\r\n\u001b[?2004l\r"]
[242.387832, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.387876, "o", "> "]
[242.388038, "o", "# Save training results to JSON file\r\n\u001b[?2004l\r"]
[242.388127, "o", "\u001b[?2004h> "]
[242.388248, "o", "results_file = '/app/training_results.json'\r\n\u001b[?2004l\r"]
[242.388289, "o", "\u001b[?2004h> "]
[242.388425, "o", "with open(results_file, 'w') as f:\r\n\u001b[?2004l\r"]
[242.388522, "o", "\u001b[?2004h> "]
[242.388636, "o", "    json.dump(results, f, indent=4)\r\n\u001b[?2004l\r"]
[242.388686, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[242.38878, "o", "> "]
[242.388944, "o", "print(f'Finished training. Results saved to {results_file}')\r\n\u001b[?2004l\r"]
