[99.642126, "o", "learning_rates = []\r\n\u001b[?2004l\ro"]
[99.642172, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rs"]
[99.642219, "o", "\u001b[?2004h> "]
[99.642457, "o", "# Best validation accuracy and corresponding epoch\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.642507, "o", "> "]
[99.642622, "o", "best_val_accuracy = 0.0\r\n\u001b[?2004l\r"]
[99.642691, "o", "\u001b[?2004h> "]
[99.642772, "o", "best_epoch = 0\r\n\u001b[?2004l\r"]
[99.642824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[99.642874, "o", "> "]
[99.642976, "o", "# Save results to JSON\r\n\u001b[?2004l\r"]
[99.643028, "o", "\u001b[?2004h> "]
[99.643076, "o", "results = {\r\n\u001b[?2004l\r"]
[99.643183, "o", "\u001b[?2004h> "]
[99.643331, "o", "    'final_epoch': total_epochs,\r\n\u001b[?2004l\r"]
[99.643401, "o", "\u001b[?2004h> "]
[99.643499, "o", "    'final_train_loss': 0.0,\r\n\u001b[?2004l\r"]
[99.643567, "o", "\u001b[?2004h> "]
[99.643664, "o", "    'final_val_loss': 0.0,\r\n\u001b[?2004l\r"]
[99.64373, "o", "\u001b[?2004h> "]
[99.643873, "o", "    'final_val_accuracy': 0.0,\r\n\u001b[?2004l\r"]
[99.643917, "o", "\u001b[?2004h> "]
[99.644095, "o", "    'best_val_accuracy': 0.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.644144, "o", "> "]
[99.644231, "o", "    'best_epoch': 0,\r\n\u001b[?2004l\r"]
[99.644278, "o", "\u001b[?2004h> "]
[99.644442, "o", "    'learning_rates': [],\r\n\u001b[?2004l\r"]
[99.644508, "o", "\u001b[?2004h> "]
[99.644624, "o", "    'train_losses': [],\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.644674, "o", "> "]
[99.644723, "o", "    'val_losses': [],\r\n\u001b[?2004l\r"]
[99.644829, "o", "\u001b[?2004h>     'val_accuracies': [],\r\n\u001b[?2004l\r"]
[99.644906, "o", "\u001b[?2004h> "]
[99.644978, "o", "    'checkpoints_saved': []\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.645049, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[99.645098, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[99.645199, "o", "# Training loop\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.645302, "o", "for epoch in range(total_epochs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.645368, "o", ">     model.train()\r\n\u001b[?2004l\r"]
[99.645437, "o", "\u001b[?2004h> "]
[99.645503, "o", "    running_loss = 0.0\r\n\u001b[?2004l\r"]
[99.645571, "o", "\u001b[?2004h> "]
[99.645635, "o", "    optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[99.645705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.645787, "o", "    # Training data loader\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.645855, "o", "> "]
[99.646061, "o", "    train_dataset = torch.utils.data.TensorDataset(X_train_tensor, y_train_tensor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.64613, "o", "> "]
[99.646384, "o", "    train_loader = torch.utils.data.DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.646454, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.646636, "o", "    for batch_idx, (data, target) in enumerate(train_loader):\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.646709, "o", "> "]
[99.646774, "o", "        output = model(data)\r\n\u001b[?2004l\r"]
[99.646862, "o", "\u001b[?2004h> "]
[99.646973, "o", "        loss = criterion(output, target)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.647025, "o", "> "]
[99.647144, "o", "        loss /= gradient_accumulation_steps\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.647193, "o", "> "]
[99.647242, "o", "        loss.backward()\r\n\u001b[?2004l\r"]
[99.647351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.647424, "o", "        # Accumulate gradients\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.647491, "o", "> "]
[99.647637, "o", "        if (batch_idx + 1) % gradient_accumulation_steps == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.647708, "o", "> "]
[99.647755, "o", "            optimizer.step()\r\n\u001b[?2004l\r"]
[99.647805, "o", "\u001b[?2004h> "]
[99.647912, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[99.647962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.648011, "o", "\u001b[?2004h> "]
[99.648196, "o", "        running_loss += loss.item() * gradient_accumulation_steps\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.648247, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.648424, "o", "    # Compute average training loss for the epoch\r\n\u001b[?2004l\r"]
[99.648478, "o", "\u001b[?2004h> "]
[99.648648, "o", "    avg_train_loss = running_loss / len(train_loader)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.648698, "o", "> "]
[99.648805, "o", "    train_losses.append(avg_train_loss)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.648876, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.648948, "o", "    # Validation phase\r\n\u001b[?2004l\r"]
[99.649019, "o", "\u001b[?2004h> "]
[99.649087, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.649159, "o", "    val_loss = 0.0\r\n\u001b[?2004l\r"]
[99.64923, "o", "\u001b[?2004h> "]
[99.6493, "o", "    correct = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.649396, "o", "    total = 0\r\n\u001b[?2004l\r"]
[99.649449, "o", "\u001b[?2004h> "]
[99.649494, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[99.649562, "o", "\u001b[?2004h> "]
[99.649796, "o", "        val_dataset = torch.utils.data.TensorDataset(X_val_tensor, y_val_tensor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.649851, "o", "> "]
[99.650127, "o", "        val_loader = torch.utils.data.DataLoader(val_dataset, batch_size=batch_size, shuffle=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650201, "o", "> "]
[99.650278, "o", "        for data, target in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650327, "o", "> "]
[99.650425, "o", "            output = model(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.650577, "o", "            loss = criterion(output, target)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650651, "o", "> "]
[99.650718, "o", "            val_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650773, "o", "> "]
[99.650924, "o", "            predicted = torch.round(torch.sigmoid(output))\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650982, "o", "> "]
[99.651066, "o", "            total += target.size(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65112, "o", "> "]
[99.651277, "o", "            correct += (predicted == target).sum().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.651346, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.651478, "o", "    avg_val_loss = val_loss / len(val_loader)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.651536, "o", "> "]
[99.651622, "o", "    val_losses.append(avg_val_loss)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.651677, "o", "> "]
[99.65176, "o", "    val_accuracy = correct / total\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65181, "o", "> "]
[99.651924, "o", "    val_accuracies.append(val_accuracy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.651976, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.652108, "o", "    # Update learning rate scheduler\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.652158, "o", "> "]
[99.652257, "o", "    cosine_scheduler.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.652426, "o", "    learning_rates.append(optimizer.param_groups[0]['lr'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.652504, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.652595, "o", "    # Save results to JSON\r\n\u001b[?2004l\r"]
[99.652645, "o", "\u001b[?2004h> "]
[99.652805, "o", "    results['final_train_loss'] = train_losses[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.652895, "o", "> "]
[99.652975, "o", "    results['final_val_loss'] = val_losses[-1]\r\n\u001b[?2004l\r"]
[99.653024, "o", "\u001b[?2004h> "]
[99.65318, "o", "    results['final_val_accuracy'] = val_accuracies[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.653232, "o", "> "]
[99.653357, "o", "    results['learning_rates'] = learning_rates\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65342, "o", "> "]
[99.653517, "o", "    results['train_losses'] = train_losses\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.653656, "o", "    results['val_losses'] = val_losses\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.653712, "o", "> "]
[99.653831, "o", "    results['val_accuracies'] = val_accuracies\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.653891, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.654044, "o", "    # Check if validation accuracy improved\r\n\u001b[?2004l\r"]
[99.654105, "o", "\u001b[?2004h> "]
[99.654218, "o", "    if val_accuracy > best_val_accuracy:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.654274, "o", "> "]
[99.654376, "o", "        best_val_accuracy = val_accuracy\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.654468, "o", "> "]
[99.654543, "o", "        best_epoch = epoch + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.654711, "o", "        results['best_val_accuracy'] = best_val_accuracy\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.654761, "o", "> "]
[99.654878, "o", "        results['best_epoch'] = best_epoch\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.654935, "o", "> "]
[99.655026, "o", "        # Save best model checkpoint\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65508, "o", "> "]
[99.655273, "o", "        checkpoint_path = os.path.join(checkpoints_dir, 'best_model.pth')\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.655331, "o", "> "]
[99.655386, "o", "        torch.save({\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.655443, "o", "> "]
[99.655585, "o", "            'epoch': epoch + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.655719, "o", "            'model_state': model.state_dict(),\r\n\u001b[?2004l\r"]
[99.655778, "o", "\u001b[?2004h> "]
[99.655937, "o", "            'optimizer_state': optimizer.state_dict(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.656029, "o", "> "]
[99.656154, "o", "            'scheduler_state': cosine_scheduler.state_dict(),\r\n\u001b[?2004l\r"]
[99.656211, "o", "\u001b[?2004h> "]
[99.656324, "o", "            'train_loss': train_losses[-1],\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.656416, "o", "> "]
[99.656505, "o", "            'val_loss': val_losses[-1],\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.656564, "o", "> "]
[99.656672, "o", "            'val_accuracy': val_accuracies[-1]\r\n\u001b[?2004l\r"]
[99.656733, "o", "\u001b[?2004h> "]
[99.656858, "o", "        }, checkpoint_path)\r\n\u001b[?2004l\r"]
[99.656916, "o", "\u001b[?2004h> "]
[99.657108, "o", "        results['checkpoints_saved'].append(checkpoint_path)\r\n\u001b[?2004l\r"]
[99.657201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65726, "o", "> "]
[99.657367, "o", "    # Save checkpoint every 5 epochs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.657451, "o", "    if (epoch + 1) % 5 == 0:\r\n\u001b[?2004l\r"]
[99.65751, "o", "\u001b[?2004h> "]
[99.657788, "o", "        checkpoint_path = os.path.join(checkpoints_dir, f'checkpoint_epoch_{epoch + 1}.pth')\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.657844, "o", "> "]
[99.657897, "o", "        torch.save({\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.657955, "o", "> "]
[99.658101, "o", "            'epoch': epoch + 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.658227, "o", "            'model_state': model.state_dict(),\r\n\u001b[?2004l\r"]
[99.658286, "o", "\u001b[?2004h> "]
[99.658446, "o", "            'optimizer_state': optimizer.state_dict(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.658504, "o", "> "]
[99.65868, "o", "            'scheduler_state': cosine_scheduler.state_dict(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.658769, "o", "> "]
[99.65886, "o", "            'train_loss': train_losses[-1],\r\n\u001b[?2004l\r"]
[99.658915, "o", "\u001b[?2004h> "]
[99.65903, "o", "            'val_loss': val_losses[-1],\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.659085, "o", "> "]
[99.659238, "o", "            'val_accuracy': val_accuracies[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.659285, "o", "> "]
[99.659408, "o", "        }, checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.659586, "o", "        results['checkpoints_saved'].append(checkpoint_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.65964, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[99.659747, "o", ">     # Print progress\r\n\u001b[?2004l\r"]
[99.659807, "o", "\u001b[?2004h> "]
[99.6604, "o", "    print(f'Epoch {epoch + 1}/{total_epochs}, Train Loss: {avg_train_loss:.4f}, Val Loss: {avg_val_loss:.4f}, Val Accuracy: {val_accuracy:.4f}, Learning Rate: {optimizer.param_groups[0]['lr']:.6f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.660463, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.660615, "o", "# Save training results to JSON file\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.660674, "o", "> "]
[99.660795, "o", "results_file = '/app/training_results.json'\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.660854, "o", "> "]
[99.660951, "o", "with open(results_file, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.661009, "o", "> "]
[99.661109, "o", "    json.dump(results, f, indent=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.661171, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.661388, "o", "print(f'Finished training. Results saved to {results_file}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.661447, "o", "> EOF\r\n\u001b[?2004l\r"]
