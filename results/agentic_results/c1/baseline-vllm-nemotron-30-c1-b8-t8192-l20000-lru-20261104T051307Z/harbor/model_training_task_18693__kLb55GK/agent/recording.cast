[68.602105, "o", "(X_val_scaled, dtype=torch.float32)\r\ny_val_tensor = tensor_type(y_val, dtype=torch.float32)\r\n\r\n# Define model architecture\r\nclass Net(nn.Module):\r\n    def __init__(self):\r\n        super(Net, self).__init__()\r\n        self.fc1 = nn.Linear(20, 128)\r\n        self.fc2 = nn.Linear(128, 64)\r\n        self.fc3 = nn.Linear(64, 1)\r\n        self.dropout = nn.Dropout(0.3)\r\n\r\n    def forward(self, x):\r\n        x = F.relu(self.fc1(x))\r\n        x = self.dropout(x)\r\n        x = F.relu(self.fc2(x))\r\n        x = self.dropout(x)\r\n        x = self.fc3(x)\r\n        return x\r\n\r\n# Initialize model, optimizer, and loss function\r\nmodel = Net()\r\noptimizer = optim.Adam(model.parameters(), lr=0.001)\r\ncriterion = nn.BCEWithLogitsLoss()\r\n\r\n# Define learning rate scheduler\r\ncosine_scheduler = optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=5, T_mult=2, eta_min=0.0001)\r\n\r\n# Create checkpoints directory if it doesn't exist\r\ncheckpoints_dir = '/app/checkpoints'\r\nos.makedirs(checkpoints_dir, exist_ok=True)\r\n\r\n# Training loop parameters\r\nbatch_size = 16\r\ngradient_accumulation_steps = 4\r\ntotal_epochs = 20\r\n\r\n# Initialize training and validation loss lists\r\ntra"]
