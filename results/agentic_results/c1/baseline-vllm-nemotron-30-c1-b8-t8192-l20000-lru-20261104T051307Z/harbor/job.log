Sending keys: ["cat > process_survey.py << EOF\nimport pandas as pd\nimport json\n\n# Read the raw survey data\nsurvey_data = pd.read_csv('survey_data.csv')\n\n# Fill missing satisfaction_score values with the median for each region\nsurvey_data['satisfaction_score'] = survey_data.groupby('region')['satisfaction_score'].transform(lambda x: x.fillna(x.median()))\n\n# Create the satisfaction_category column\nsurvey_data['satisfaction_category'] = pd.cut(survey_data['satisfaction_score'],\n                                            bins=[-1, 3, 6, 10],\n                                            labels=['Dissatisfied', 'Neutral', 'Satisfied'])\n\n# Save the cleaned dataset\nsurvey_data.to_csv('cleaned_survey_data.csv', index=False)\n\n# Calculate summary statistics\nsummary_stats = survey_data.groupby('region')['satisfaction_score'].agg(\n    count=('satisfaction_score', 'count'),\n    mean=('satisfaction_score', 'mean'),\n    median=('satisfaction_score', 'median'),\n    std=('satisfaction_score', 'std')\n)\n\n# Generate the summary report\ntotal_responses = len(survey_data)\noverall_satisfaction = survey_data['satisfaction_score'].mean()\nsatisfaction_distribution = survey_data['satisfaction_category'].value_counts().to_dict()\nby_region = summary_stats['mean'].to_dict()\nbest_region = summary_stats['mean'].idxmax()\nworst_region = summary_stats['mean'].idxmin()\n\n# Create the JSON report\nreport = {\n    'total_responses': total_responses,\n    'overall_satisfaction': round(overall_satisfaction, 2),\n    'by_region': by_region,\n    'satisfaction_distribution': satisfaction_distribution,\n    'best_region': best_region,\n    'worst_region': worst_region\n}\n\n# Save the JSON report\nwith open('summary_report.json', 'w') as f:\n    json.dump(report, f)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
