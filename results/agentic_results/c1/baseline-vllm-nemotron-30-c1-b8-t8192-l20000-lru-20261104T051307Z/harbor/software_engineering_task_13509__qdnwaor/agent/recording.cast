[46.861706, "i", "echo \"# Makefile for the calculator project\\n\\n# Variables\\nPROJECT_NAME = calculator\\nTARGET_TYPE = executable\\nSOURCES = src/main.cpp src/math.cpp\\nHEADERS = include/math.h\\nCOMPILER = g++\\nSTANDARD = c++17\\nOPTIMIZATION = debug\\nINCLUDE_DIRS = include/\\nLIBRARY_DIRS = \\nLIBRARIES = m\\nDEFINES = DEBUG=1\\nWARNINGS = all extra\\nOUTPUT_DIR = build/\\nCLEAN_PATTERNS = *.o *.d calculator\\n\\n# Objects\\nOBJECTS = $(SOURCES:.cpp=.o)\\n\\n# Compiler flags\\nCFLAGS = -std=$(STANDARD) -Wall -Wextra -I$(INCLUDE_DIRS) -D$(DEFINES) $(WARNINGS)\\nLFLAGS = -L$(LIBRARY_DIRS) -l$(LIBRARIES)\\n\\n# Default target\\nall: $(OUTPUT_DIR)/$(PROJECT_NAME)\\n\\n# Build target\\n$(OUTPUT_DIR)/$(PROJECT_NAME): $(OBJECTS)\\n\\t@echo 'Building $(PROJECT_NAME)'\\n\\t$(COMPILER) $(CFLAGS) $(LFLAGS) -o $@ $^\\n\\n# Compile rule\\n$(OUTPUT_DIR)/%.o: %.cpp\\n\\t@echo 'Compiling $<'\n\\t$(COMPILER) $(CFLAGS) -c -o $@ $<\\n\\n# Dependency rules\\n-include $(OBJECTS:.o=.d)\\n\\n# Clean target\\nclean:\\n\\t@echo 'Cleaning build files'\\n\\trm -f $(CLEAN_PATTERNS)\\n\\n# Phony targets\\n.PHONY: all clean\" > /app/Makefile\n"]
[46.864699, "o", "echo \"# Makefile for the calculator project\\n\\n# Variables\\nPROJECT_NAME = calculator\\nTARGET_TYPE = executable\\nSOURCES = src/main.cpp src/math.cpp\\nHEADERS = include/math.h\\nCOMPILER = g++\\nSTANDARD = c++17\\nOPTIMIZATION = debug\\nINCLUDE_DIRS = include/\\nLIBRARY_DIRS = \\nLIBRARIES = m\\nDEFINES = DEBUG=1\\nWARNINGS = all extra\\nOUTPUT_DIR = build/\\nCLEAN_PATTERNS = *.o *.d calculator\\n\\n# Objects\\nOBJECTS = $(SOURCES:.cpp=.o)\\n\\n# Compiler flags\\nCFLAGS = -std=$(STANDARD) -Wall -Wextra -I$(INCLUDE_DIRS) -D$(DEFINES) $(WARNINGS)\\nLFLAGS = -L$(LIBRARY_DIRS) -l$(LIBRARIES)\\n\\n# Default target\\nall: $(OUTPUT_DIR)/$(PROJECT_NAME)\\n\\n# Build target\\n$(OUTPUT_DIR)/$(PROJECT_NAME): $(OBJECTS)\\n\\t@echo 'Building $(PROJECT_NAME)'\\n\\t$(COMPILER) $(CFLAGS) $(LFLAGS) -o $@ $^\\n\\n# Compile rule\\n$(OUTPUT_DIR)/%.o: %.cpp\\n\\t@echo 'Compiling $<'\r\n\u001b[?2004l\r"]
