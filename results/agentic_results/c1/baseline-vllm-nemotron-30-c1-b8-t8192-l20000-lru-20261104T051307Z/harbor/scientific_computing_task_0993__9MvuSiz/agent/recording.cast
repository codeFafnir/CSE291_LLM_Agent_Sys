[24.307113, "i", "python3 -c \"import json; params = json.load(open('/app/parameters.json')); alpha = params['alpha']; K = params['K']; y0 = params['y0']; t_start = params['t_start']; t_end = params['t_end']; num_steps = params['num_steps']; h = (t_end - t_start) / num_steps; y = y0; t = t_start; results = [[t, y]]; for i in range(1, num_steps + 1): t = t_start + i * h; y = y + h * alpha * y * (1 - y / K); results.append([t, y]); with open('/app/output/results.csv', 'a') as f: for row in results: f.write(f\"{row[0]:.4f},{row[1]:.4f}\\n\")\";\n"]
