[79.723439, "i", "cat << EOF > /app/summary.py\nimport pandas as pd\nimport json\n\nresults = pd.read_csv('/app/output/results.csv')\nfinal_population = results.iloc[-1]['population']\nmax_population = results['population'].max()\nconvergence_time = None\nfor index, row in results.iterrows():\n    if abs(row['population'] - 1000.0) < 0.01 * 1000.0:\n        convergence_time = row['time']\n        break\nwith open('/app/output/summary.json', 'w') as f:\n    json.dump({\n        'final_population': round(final_population, 4),\n        'max_population': round(max_population, 4),\n        'convergence_time': round(convergence_time, 4) if convergence_time is not None else None\n    }, f)\nEOF\n"]
