[159.164032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[159.164093, "o", "\u001b[?2004h> "]
[159.164203, "o", "    print(\"All checks passed.\")\r\n\u001b[?2004l\r"]
[159.164261, "o", "\u001b[?2004h> "]
[159.164367, "o", "    sys.exit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
