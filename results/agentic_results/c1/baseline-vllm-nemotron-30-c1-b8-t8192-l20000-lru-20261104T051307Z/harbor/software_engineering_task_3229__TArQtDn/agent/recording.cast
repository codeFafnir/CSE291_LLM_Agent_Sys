[58.414235, "i", "echo \"import os\\nimport sys\\nimport subprocess\\nimport zipfile\\n\\ntry:\\n    # Build the package\\n    subprocess.run([\\\"python\\\", \\\"setup.py\\\", \\\"sdist\\\", \\\"bdist_wheel\\\"], check=True)\\n\\n    # Check if the distribution files were created\\n    dist_dir = os.path.join(os.getcwd(), \\\"dist\\\")\\n    if not os.path.exists(dist_dir):\\n        raise Exception(\\\"No distribution files found in the dist directory.\\\")\\n\\n    # Check if the package contains all necessary files\\n    with zipfile.ZipFile(os.path.join(dist_dir, \\\"*.tar.gz\\\"), \\\"r\\\") as zf:\\n        files = zf.namelist()\\n        if \\\"mymodule/calculator.py\\\" not in files:\\n            raise Exception(\\\"calculator.py is missing from the distribution.\\\")\\n\\n    # Check if the metadata is correct\\n    with open(os.path.join(dist_dir, \\\"PKG-INFO\\\"), \\\"r\\\") as f:\\n        metadata = f.read()\\n        if \\\"Name: correct-package-name\\\" not in metadata:\\n            raise Exception(\\\"Incorrect package name in metadata.\")\\n        if \\\"Version: 1.0.0\\\" not in metadata:\\n            raise Exception(\\\"Incorrect package version in metadata.\")\\n\\n    print(\\\"All checks passed.\")\\n    sys.exit(0)\\nexcept Exception as e:\\n    print(str(e), file=sys.stderr)\\n    sys.exit(1)\" > /app/verify_build.py\n"]
[58.418609, "o", "echo \"import os\\nimport sys\\nimport subprocess\\nimport zipfile\\n\\ntry:\\n    # Build the package\\n    subprocess.run([\\\"python\\\", \\\"setup.py\\\", \\\"sdist\\\", \\\"bdist_wheel\\\"], check=True)\\n\\n    # Check if the distribution files were created\\n    dist_dir = os.path.join(os.getcwd(), \\\"dist\\\")\\n    if not os.path.exists(dist_dir):\\n        raise Exception(\\\"No distribution files found in the dist directory.\\\")\\n\\n    # Check if the package contains all necessary files\\n    with zipfile.ZipFile(os.path.join(dist_dir, \\\"*.tar.gz\\\"), \\\"r\\\") as zf:\\n        files = zf.namelist()\\n        if \\\"mymodule/calculator.py\\\" not in files:\\n            raise Exception(\\\"calculator.py is missing from the distribution.\\\")\\n\\n    # Check if the metadata is correct\\n    with open(os.path.join(dist_dir, \\\"PKG-INFO\\\"), \\\"r\\\") as f:\\n        metadata = f.read()\\n        if \\\"Name: correct-package-name\\\" not in metadata:\\n            raise Exception(\\\"Incorrect package name in metadata.\")\\n        if \\\"Version: 1.0.0\\\" not in metadata:\\n            raise Exception(\\\"Incorrect package version in metadata.\")\\n\\n    print(\\\"All checks passed.\")\\n    sys.exit(0)\\nexcept Exception as e:\\n    print(str(e), file=sys.stderr)\\n    sys.exit(1)\" > /app/verify_build.py\r\n\u001b[?2004l\r"]
