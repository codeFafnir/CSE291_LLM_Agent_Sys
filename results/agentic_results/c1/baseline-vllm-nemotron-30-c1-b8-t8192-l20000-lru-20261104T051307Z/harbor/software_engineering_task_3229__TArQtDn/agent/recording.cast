[159.163498, "o", "            raise Exception(\"Incorrect package name in metadata.\")\r\n\u001b[?2004l\r"]
[159.163554, "o", "\u001b[?2004h> "]
[159.163693, "o", "        if \"Version: 1.0.0\" not in metadata:\r\n\u001b[?2004l\r\u001b[?2004h"]
[159.16375, "o", "> "]
