[0.933911, "o", "\u001b[?2004hroot@3ecaccb3d917:/app# "]
[14.681168, "i", "cat > /app/fixed_config.py <<EOF\nimport yaml\nfrom ruamel.yaml import YAML\n\n# Read the corrupted YAML file\nwith open('/app/build_config.yaml', 'r') as file:\n    data = yaml.safe_load(file)\n\n# Remove duplicate keys (keep the first occurrence)\ndef remove_duplicates(d):\n    new_d = {}\n    for k, v in d.items():\n        if k not in new_d:\n            new_d[k] = v\n        else:\n            # If the key already exists, keep the first occurrence\n            pass\n    return new_d\n\ndata = remove_duplicates(data)\n\n# Convert keys with dots to underscores\ndef replace_dots_with_underscores(d):\n    new_d = {}\n    for k, v in d.items():\n        new_key = k.replace('.', '_')\n        new_d[new_key] = v\n    return new_d\n\ndata = replace_dots_with_underscores(data)\n\n# Uncomment lines that start with '# active:'\ndef uncomment_active_lines(d):\n    new_d = {}\n    for k, v in d.items():\n        if isinstance(v, dict):\n            new_d[k] = uncomment_active_lines(v)\n        elif isinstance(v, str):\n            if v.startswith('# active:'):\n                new_d[k] = v[1:].strip()\n            else:\n                new_d[k] = v\n        else:\n            new_d[k] = v\n    return new_d\n\ndata = uncomment_active_lines(data)\n\n# Ensure proper YAML indentation (2 spaces per level)\ndef format_yaml(d):\n    yaml = YAML()\n    yaml.indent(mapping=2, sequence=4, offset=2)\n    with open('/app/fixed_config.yaml', 'w') as file:\n        yaml.dump(d, file)\n\nformat_yaml(data)\nEOF\n"]
