[54.338211, "o", "project:\r\n  name: My Project\r\n  version: 1.0.0\r\nbuild:\r\n  source_dir: src\r\n  output_dir: dist\r\n  compiler.flags: -O2 -Wall\r\n  tests: false\r\ndependencies:\r\n  required:\r\n    - python>=3.8\r\n    - requests>=2.25\r\n  optional:\r\n    - pytest>=6.0\r\ndeployment_target: production\r\ndeployment_region: us-east-1\r\n"]
