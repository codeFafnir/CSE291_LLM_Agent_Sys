[71.737466, "o", "\u001b[?2004h> "]
[71.737596, "o", "    data = yaml.safe_load(file)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.737824, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.737884, "o", "# Remove duplicate keys (keep the first occurrence)\r\n\u001b[?2004l\r"]
[71.737928, "o", "\u001b[?2004h> "]
[71.738086, "o", "def remove_duplicates(d):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.738287, "o", "    new_d = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.738356, "o", "    for k, v in d.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.738513, "o", "> "]
[71.738575, "o", "        if k not in new_d:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.7387, "o", "            new_d[k] = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.738788, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.739012, "o", "            # If the key already exists, keep the first occurrence\r\n\u001b[?2004l\r"]
[71.739107, "o", "\u001b[?2004h> "]
[71.739152, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.739255, "o", "    return new_d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.73935, "o", "\u001b[?2004h> "]
[71.739448, "o", "data = remove_duplicates(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.739531, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.739697, "o", "# Convert keys with dots to underscores\r\n\u001b[?2004l\r"]
[71.739751, "o", "\u001b[?2004h> "]
[71.739898, "o", "def replace_dots_with_underscores(d):\r\n\u001b[?2004l\r"]
[71.739971, "o", "\u001b[?2004h> "]
[71.74004, "o", "    new_d = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.740149, "o", "    for k, v in d.items():\r\n\u001b[?2004l\r"]
[71.740223, "o", "\u001b[?2004h> "]
[71.740352, "o", "        new_key = k.replace('.', '_')\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.740404, "o", "> "]
[71.740513, "o", "        new_d[new_key] = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.740577, "o", "> "]
[71.740634, "o", "    return new_d\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.740687, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.740841, "o", "data = replace_dots_with_underscores(data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.740892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.741047, "o", "# Uncomment lines that start with '# active:'\r\n\u001b[?2004l\r"]
[71.741109, "o", "\u001b[?2004h> "]
[71.741203, "o", "def uncomment_active_lines(d):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.741293, "o", "    new_d = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.741351, "o", "> "]
[71.741402, "o", "    for k, v in d.items():\r\n\u001b[?2004l\r"]
[71.741456, "o", "\u001b[?2004h> "]
[71.741606, "o", "        if isinstance(v, dict):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.741731, "o", "            new_d[k] = uncomment_active_lines(v)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.741824, "o", "> "]
[71.741893, "o", "        elif isinstance(v, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.742025, "o", "            if v.startswith('# active:'):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742085, "o", "> "]
[71.742205, "o", "                new_d[k] = v[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742257, "o", "> "]
[71.74237, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742454, "o", ">                 new_d[k] = v"]
[71.742556, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.74265, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.742722, "o", "            new_d[k] = v\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742772, "o", "> "]
[71.742821, "o", "    return new_d\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742877, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.742933, "o", "> "]
[71.743031, "o", "data = uncomment_active_lines(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.743083, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.74328, "o", "# Ensure proper YAML indentation (2 spaces per level)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.74333, "o", "> "]
[71.743381, "o", "def format_yaml(d):\r\n\u001b[?2004l\r"]
[71.743524, "o", "\u001b[?2004h> "]
[71.743573, "o", "    yaml = YAML()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.74368, "o", "    yaml.indent(mapping=2, sequence=4, offset=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.743771, "o", "> "]
[71.743902, "o", "    with open('/app/fixed_config.yaml', 'w') as file:\r\n\u001b[?2004l\r"]
[71.743959, "o", "\u001b[?2004h> "]
[71.744054, "o", "        yaml.dump(d, file)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.744113, "o", "\u001b[?2004h> "]
[71.744228, "o", "# Ensure 'tests: true' is used\r\n\u001b[?2004l\r"]
[71.744285, "o", "\u001b[?2004h> "]
[71.744393, "o", "if 'tests' in data['build']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.744451, "o", "> "]
[71.744534, "o", "    data['build']['tests'] = True\r\n\u001b[?2004l\r"]
[71.744592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.744644, "o", "> "]
[71.744883, "o", "# Ensure 'deployment' is a key with 'deployment_target' and 'deployment_region'\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.744936, "o", "> "]
[71.745028, "o", "def add_deployment_key(d):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.745161, "o", "    if 'deployment_target' in d:\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.745218, "o", "> "]
[71.745279, "o", "        deployment = {\r\n\u001b[?2004l\r"]
[71.745381, "o", "\u001b[?2004h> "]
[71.745502, "o", "            'deployment_target': d['deployment_target'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.745557, "o", "> "]
[71.745723, "o", "            'deployment_region': d['deployment_region']\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.7458, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.745951, "o", "        d['deployment'] = deployment\r\n\u001b[?2004l\r"]
[71.746008, "o", "\u001b[?2004h> "]
[71.746125, "o", "        del d['deployment_target']\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.74618, "o", "> "]
[71.746285, "o", "        del d['deployment_region']\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.746342, "o", "> "]
[71.746395, "o", "    return d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[71.746449, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.746576, "o", "data = add_deployment_key(data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.746629, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.746706, "o", "format_yaml(data)\r\n\u001b[?2004l\r"]
