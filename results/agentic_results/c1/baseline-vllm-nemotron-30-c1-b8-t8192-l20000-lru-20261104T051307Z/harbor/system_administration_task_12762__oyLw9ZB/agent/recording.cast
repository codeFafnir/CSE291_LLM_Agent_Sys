[41.967057, "o", "                if ip_match:\r\n\u001b[?2004l\r"]
[41.967137, "o", "\u001b[?2004h> "]
[41.967377, "o", "                    self.file_details[file_path][\"ips_found\"].add(ip_match.group())\r\n\u001b[?2004l\r"]
[41.967422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[41.967501, "o", "> "]
[41.967549, "o", "        self.save_state()\r\n\u001b[?2004l\r"]
[41.967595, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.9677, "o", "\u001b[?2004h> "]
[41.967749, "o", "    def generate_report(self):\r\n\u001b[?2004l\r"]
[41.967846, "o", "\u001b[?2004h> "]
[41.967896, "o", "        now = time.time()\r\n\u001b[?2004l\r"]
[41.967985, "o", "\u001b[?2004h> "]
[41.968114, "o", "        duration = now - self.last_report_time\r\n\u001b[?2004l\r"]
[41.96816, "o", "\u001b[?2004h> "]
[41.968293, "o", "        self.last_report_time = now\r\n\u001b[?2004l\r"]
[41.968344, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[41.96839, "o", "\u001b[?2004h> "]
[41.968486, "o", "        report = {\r\n\u001b[?2004l\r"]
[41.968525, "o", "\u001b[?2004h> "]
[41.968789, "o", "            \"timestamp\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime(now)),\r\n\u001b[?2004l\r"]
[41.968837, "o", "\u001b[?2004h> "]
[41.969, "o", "            \"scan_duration_seconds\": duration,\r\n\u001b[?2004l\r"]
[41.969044, "o", "\u001b[?2004h> "]
[41.969254, "o", "            \"files_monitored\": list(self.file_details.keys()),\r\n\u001b[?2004l\r"]
[41.969301, "o", "\u001b[?2004h> "]
[41.969402, "o", "            \"statistics\": {\r\n\u001b[?2004l\r"]
[41.969437, "o", "\u001b[?2004h> "]
[41.96969, "o", "                \"total_lines_processed\": self.stats[\"total_lines_processed\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.969761, "o", "> "]
[41.969904, "o", "                \"total_errors\": self.stats[\"total_errors\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.96997, "o", "> "]
[41.970142, "o", "                \"total_warnings\": self.stats[\"total_warnings\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.970215, "o", "> "]
[41.970411, "o", "                \"total_auth_failures\": self.stats[\"total_auth_failures\"],\r\n\u001b[?2004l\r"]
[41.970492, "o", "\u001b[?2004h> "]
[41.97068, "o", "                \"unique_ips_found\": len(self.stats[\"unique_ips_found\"])\r\n\u001b[?2004l\r"]
[41.970723, "o", "\u001b[?2004h> "]
[41.970833, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.970878, "o", "> "]
[41.970958, "o", "            \"file_details\": {}\r\n\u001b[?2004l\r"]
[41.971046, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.971097, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.971292, "o", "        for file_path, file_data in self.file_details.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.971342, "o", "> "]
[41.971476, "o", "            report[\"file_details\"][file_path] = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.97153, "o", "> "]
[41.971717, "o", "                \"lines_processed\": file_data[\"lines_processed\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.971766, "o", "> "]
[41.971899, "o", "                \"errors\": file_data[\"errors\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.971986, "o", "> "]
[41.972084, "o", "                \"warnings\": file_data[\"warnings\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.972132, "o", "> "]
[41.972297, "o", "                \"auth_failures\": file_data[\"auth_failures\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.972342, "o", "> "]
[41.972517, "o", "                \"ips_found\": list(file_data[\"ips_found\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.972574, "o", "> "]
[41.97267, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.972763, "o", "        # Alerts\r\n\u001b[?2004l\r"]
[41.972807, "o", "\u001b[?2004h> "]
[41.972913, "o", "        alerts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.973104, "o", "        for file_path, file_data in self.file_details.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.973189, "o", "> "]
[41.973294, "o", "            if file_data[\"lines_processed\"] > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.973346, "o", "> "]
[41.973566, "o", "                error_rate = file_data[\"errors\"] / file_data[\"lines_processed\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.973614, "o", "> "]
[41.973708, "o", "                if error_rate > 0.1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.973758, "o", "> "]
[41.973859, "o", "                    alerts.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.97404, "o", "                        \"type\": \"high_error_rate\",\r\n\u001b[?2004l\r"]
[41.974123, "o", "\u001b[?2004h> "]
[41.974387, "o", "                        \"message\": f\"High error rate ({error_rate:.2f}) in {file_path}\",\r\n\u001b[?2004l\r"]
[41.974473, "o", "\u001b[?2004h> "]
[41.974571, "o", "                        \"threshold_exceeded\": True\r\n\u001b[?2004l\r"]
[41.974662, "o", "\u001b[?2004h> "]
[41.974711, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.974812, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.974957, "o", "                if file_data[\"auth_failures\"] > 5:\r\n\u001b[?2004l\r"]
[41.975049, "o", "\u001b[?2004h> "]
[41.975124, "o", "                    alerts.append({\r\n\u001b[?2004l\r"]
[41.975218, "o", "\u001b[?2004h> "]
[41.97532, "o", "                        \"type\": \"auth_failure_spike\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.975419, "o", "> "]
[41.975589, "o", "                        \"message\": f\"More than 5 auth failures in {file_path}\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.975676, "o", "> "]
[41.975786, "o", "                        \"threshold_exceeded\": True\r\n\u001b[?2004l\r"]
[41.975891, "o", "\u001b[?2004h> "]
[41.975936, "o", "                    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.976022, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.976127, "o", "        report[\"alerts\"] = alerts\r\n\u001b[?2004l\r"]
[41.976209, "o", "\u001b[?2004h> "]
[41.976273, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.976445, "o", "        with open(\"/app/reports/log_summary.json\", \"w\") as f:\r\n\u001b[?2004l\r"]
[41.976537, "o", "\u001b[?2004h> "]
[41.976607, "o", "            json.dump(report, f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.97665, "o", "> \r\n\u001b[?2004l\r"]
[41.976744, "o", "\u001b[?2004h> "]
[41.97679, "o", "    def run(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.976903, "o", "        observer = Observer()\r\n\u001b[?2004l\r"]
[41.976987, "o", "\u001b[?2004h> "]
[41.977167, "o", "        observer.schedule(self, \"/app/logs/webserver\", recursive=True)\r\n\u001b[?2004l\r"]
[41.977253, "o", "\u001b[?2004h> "]
[41.977423, "o", "        observer.schedule(self, \"/app/logs/database\", recursive=True)\r\n\u001b[?2004l\r"]
[41.977515, "o", "\u001b[?2004h> "]
[41.977565, "o", "        observer.start()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.977694, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.977733, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.977831, "o", "            while True:\r\n\u001b[?2004l\r"]
[41.97793, "o", "\u001b[?2004h> "]
[41.978077, "o", "                if time.time() - self.last_report_time >= 300:\r\n\u001b[?2004l\r"]
[41.978125, "o", "\u001b[?2004h> "]
[41.978249, "o", "                    self.generate_report()\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.978303, "o", "> "]
[41.978385, "o", "                time.sleep(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.978484, "o", "> "]
[41.978537, "o", "        except KeyboardInterrupt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.978639, "o", "            observer.stop()\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.978726, "o", "> "]
[41.978825, "o", "        observer.join()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.978871, "o", "\u001b[?2004h> "]
[41.978918, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.979041, "o", "    handler = LogMonitorHandler()\r\n\u001b[?2004l\r"]
[41.979085, "o", "\u001b[?2004h> "]
[41.979226, "o", "    handler.run()\" > /app/log_watcher.py\r\n\u001b[?2004l\r"]
[41.979276, "o", "\u001b[?2004h> "]
[51.614093, "i", "systemctl daemon-reload\n"]
[51.614346, "o", "systemctl daemon-reload\r\n\u001b[?2004l\r"]
[51.614443, "o", "\u001b[?2004h> "]
[51.715866, "i", "systemctl enable log-monitor\n"]
[51.716139, "o", "systemctl enable log-monitor\r\n\u001b[?2004l\r"]
[51.716228, "o", "\u001b[?2004h> "]
[51.814238, "i", "systemctl start log-monitor\n"]
[51.814457, "o", "systemctl start log-monitor\r\n\u001b[?2004l\r"]
[51.814517, "o", "\u001b[?2004h> "]
[52.819231, "i", "sleep 300\n"]
[52.819413, "o", "sleep 300\r\n\u001b[?2004l\r"]
[52.819483, "o", "\u001b[?2004h> "]
[112.842182, "i", "cat /app/reports/log_summary.json\n"]
[112.842478, "o", "cat /app/reports/log_summary.json\r\n\u001b[?2004l\r"]
[112.842538, "o", "\u001b[?2004h> "]
[116.36266, "i", "cat /app/reports/log_summary.json\n"]
[116.362922, "o", "cat /app/reports/log_summary.json\r\n\u001b[?2004l\r"]
[116.363056, "o", "\u001b[?2004h> "]
[121.267723, "i", "journalctl -u log-monitor.service -b\n"]
[121.268185, "o", "journalctl -u log-monitor.service -b\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.268323, "o", "> "]
