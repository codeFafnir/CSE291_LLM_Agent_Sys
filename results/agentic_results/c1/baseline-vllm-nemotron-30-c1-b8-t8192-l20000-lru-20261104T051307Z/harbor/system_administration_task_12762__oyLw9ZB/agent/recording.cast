[41.743626, "i", "mkdir -p /app/logs/webserver /app/logs/database /app/reports /app/state\n"]
[41.74412, "o", "mkdir -p /app/logs/webserver /app/logs/database /app/reports /app/state\r\n\u001b[?2004l\r"]
[41.746106, "o", "\u001b[?2004hroot@95e150ce55c5:/app# "]
[41.845526, "i", "echo '[Unit]\nDescription=Log Monitoring Service for Security Analysis\n\n[Service]\nType=simple\nUser=nobody\nWorkingDirectory=/app\nExecStart=/usr/bin/python3 /app/log_watcher.py\nRestart=on-failure\nRestartSec=10\nStandardOutput=syslog\nStandardError=syslog\n\n[Install]\nWantedBy=multi-user.target' > /app/log-monitor.service\n"]
[41.845751, "o", "echo '[Unit]\r\n\u001b[?2004l\r"]
[41.845843, "o", "\u001b[?2004h> "]
[41.846072, "o", "Description=Log Monitoring Service for Security Analysis\r\n\u001b[?2004l\r"]
[41.846226, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.846281, "o", "[Service]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.846444, "o", "Type=simple\r\n\u001b[?2004l\r\u001b[?2004h> User=nobody\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.846587, "o", "WorkingDirectory=/app\r\n\u001b[?2004l\r"]
[41.846671, "o", "\u001b[?2004h> "]
[41.846814, "o", "ExecStart=/usr/bin/python3 /app/log_watcher.py\r\n\u001b[?2004l\r"]
[41.846858, "o", "\u001b[?2004h> "]
[41.847034, "o", "Restart=on-failure\r\n\u001b[?2004l\r\u001b[?2004h> "]
