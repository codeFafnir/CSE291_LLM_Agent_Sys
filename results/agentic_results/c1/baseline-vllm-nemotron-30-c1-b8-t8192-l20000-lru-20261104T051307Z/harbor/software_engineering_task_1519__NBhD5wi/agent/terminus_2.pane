[?2004hroot@159a7ffeecb1:/app# echo "import yaml\nimport json\nimport re\nimport sys\n\n# Read input file\nwith open('/app/config.input', 'r') as file:\n    content = file.read()\n\n# Detect format\ntry:\n    json_data = json.loads(content)\n    file_format = 'json'\nexcept json.JSONDecodeError:\n    try:\n        yaml_data = yaml.safe_load(content)\n        file_format = 'yaml'\n    except yaml.YAMLError:\n        print('VALIDATION FAILED\\nErrors:\\n- Invalid file format')\n        sys.exit(1)\n\n# Validate structure\ndef validate_structure(data):\n    errors = []\n    if 'application' not in data or not isinstance(data['application'], str):\n        errors.append("Top-level key 'application' is missing or not a string.")\n    if 'version' not in data or not isinstance(data['version'], str) or not re.match(r'\\d+\\.\\d+\\.\\d+', data['version']):\n        errors.append("Top-level key 'version' is missing, not a string, or not in semantic version format (X.Y.Z).")\n    if 'settings' not in data or not isinstance(data['settings'], dict):\n        errors.append("Top-level key 'settings' is missing or not a dictionary.")\n    for key in data:\n        if not isinstance(key, str):\n            errors.append(f'Key {key} is not a string.')\n    return errors\n\nerrors = validate_structure(json_data if file_format == 'json' else yaml_data)\n\nif errors:\n    with open('/app/config.output', 'w') as output_file:\n        output_file.write('VALIDATION FAILED\\nErrors:\\n')\n        for error in errors:\n            output_file.write(f'- {error}\\n')\n    sys.exit(1)\n\n# Convert format\nif file_format == 'json':\n    converted_data = yaml.dump(json_data, default_flow_style=False)\nelse:\n    converted_data = json.dumps(yaml_data, indent=2)\n\n# Write converted data to output file\nwith open('/app/config.output', 'w') as output_file:\n    output_file.write(converted_data)" > config_validator.py
