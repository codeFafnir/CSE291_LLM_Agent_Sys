[?2004limport json\nimport numpy as np\n\n# Read parameters from input.json\nwith open('/app/input.json', 'r') as f:\n    params = json.load(f)\n\n# Extract parameters\nmass = params['mass']\nspring_constant = params['spring_constant']\ninitial_position = params['initial_position']\ninitial_velocity = params['initial_velocity']\ntime_step = params['time_step']\ntotal_time = params['total_time']\nenergy_tolerance = params['energy_tolerance']\n\n# Calculate total steps\ntotal_steps = int(total_time / time_step)\n\n# Initialize arrays\ntime = np.zeros(total_steps)\nposition = np.zeros(total_steps)\nvelocity = np.zeros(total_steps)\nkinetic_energy = np.zeros(total_steps)\npotential_energy = np.zeros(total_steps)\ntotal_energy = np.zeros(total_steps)\n\n# Set initial conditions\nposition[0] = initial_position\nvelocity[0] = initial_velocity\ntime[0] = 0.0\n\n# Calculate initial energy\nkinetic_energy[0] = 0.5 * mass * velocity[0]**2\npotential_energy[0] = 0.5 * spring_constant * position[0]**2\ntotal_energy[0] = kinetic_energy[0] + potential_energy[0]\n\n# Perform Euler's method\nfor i in range(1, total_steps):\n    time[i] = time[i-1] + time_step\n    position[i] = position[i-1] + velocity[i-1] * time_step\n    velocity[i] = velocity[i-1] - (spring_constant / mass) * position[i-1] * time_step\n    kinetic_energy[i] = 0.5 * mass * velocity[i]**2\npotential_energy[i] = 0.5 * spring_constant * position[i]**2\ntotal_energy[i] = kinetic_energy[i] + potential_energy[i]\n\n# Analyze energy conservation\ninitial_energy = total_energy[0]\nmax_energy_change = 100 * np.max(np.abs(total_energy - initial_energy)) / np.abs(initial_energy)\nenergy_conserving = max_energy_change <= energy_tolerance\n\n# Prepare results\nsimulation_summary = {\n    'total_steps': total_steps,\n    'final_time': time[-1],\n    'final_position': position[-1],\n    'final_velocity': velocity[-1],\n    'initial_energy': initial_energy,\n    'final_energy': total_energy[-1],\n    'max_energy_change_percent': max_energy_change,\n    'energy_conserving': energy_conserving\n}\n\nfirst_5_steps = [\n    {\n        'time': time[0],\n        'position': position[0],\n        'velocity': velocity[0],\n        'ke': kinetic_energy[0],\n        'pe': potential_energy[0],\n        'te': total_energy[0]\n    },\n    {\n        'time': time[1],\n        'position': position[1],\n        'velocity': velocity[1],\n        'ke': kinetic_energy[1],\n        'pe': potential_energy[1],\n        'te': total_energy[1]\n    },\n    {\n        'time': time[2],\n        'position': position[2],\n        'velocity': velocity[2],\n        'ke': kinetic_energy[2],\n        'pe': potential_energy[2],\n        'te': total_energy[2]\n    },\n    {\n        'time': time[3],\n        'position': position[3],\n        'velocity': velocity[3],\n        'ke': kinetic_energy[3],\n        'pe': potential_energy[3],\n        'te': total_energy[3]\n    },\n    {\n        'time': time[4],\n        'position': position[4],\n        'velocity': velocity[4],\n        'ke': kinetic_energy[4],\n        'pe': potential_energy[4],\n        'te': total_energy[4]\n    }\n]\n\nlast_5_steps = [\n    {\n        'time': time[-5],\n        'position': position[-5],\n        'velocity': velocity[-5],\n        'ke': kinetic_energy[-5],\n        'pe': potential_energy[-5],\n        'te': total_energy[-5]\n    },\n    {\n        'time': time[-4],\n        'position': position[-4],\n        'velocity': velocity[-4],\n        'ke': kinetic_energy[-4],\n        'pe': potential_energy[-4],\n        'te': total_energy[-4]\n    },\n    {\n        'time': time[-3],\n        'position': position[-3],\n        'velocity': velocity[-3],\n        'ke': kinetic_energy[-3],\n        'pe': potential_energy[-3],\n        'te': total_energy[-3]\n    },\n    {\n        'time': time[-2],\n        'position': position[-2],\n        'velocity': velocity[-2],\n        'ke': kinetic_energy[-2],\n        'pe': potential_energy[-2],\n        'te': total_energy[-2]\n    },\n    {\n        'time': time[-1],\n        'position': position[-1],\n        'velocity': velocity[-1],\n        'ke': kinetic_energy[-1],\n        'pe': potential_energy[-1],\n        'te': total_energy[-1]\n    }\n]\n\nresults = {\n    'simulation_summary': simulation_summary,\n    'first_5_steps': first_5_steps,\n    'last_5_steps': last_5_steps\n}\n\n# Save results to JSON\nwith open('/app/output/results.json', 'w') as f:\n    json.dump(results, f, indent=4)\n\n# Save trajectory to CSV\nimport csv\nwith open('/app/output/trajectory.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['time', 'position', 'velocity', 'kinetic_energy', 'potential_energy', 'total_energy'])\n    for i in range(total_steps):\n        writer.writerow([\n            time[i],\n            position[i],\n            velocity[i],\n            kinetic_energy[i],\n            potential_energy[i],\n            total_energy[i]\n        ])\n
