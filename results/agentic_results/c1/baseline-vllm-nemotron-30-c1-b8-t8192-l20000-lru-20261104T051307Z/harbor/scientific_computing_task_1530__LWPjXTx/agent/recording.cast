gy,\\n    'final_energy': total_energy[-1],\\n    'max_energy_change_percent': max_energy_change,\\n    'energy_conserving': energy_conserving\\n}\\n\\nfirst_5_steps = [\\n    {\\n        'time': time[0],\\n        'position': position[0],\\n        'velocity': velocity[0],\\n        'ke': kinetic_energy[0],\\n        'pe': potential_energy[0],\\n        'te': total_energy[0]\\n    },\\n    {\\n        'time': time[1],\\n        'position': position[1],\\n        'velocity': velocity[1],\\n        'ke': kinetic_energy[1],\\n        'pe': potential_energy[1],\\n        'te': total_energy[1]\\n    },\\n    {\\n        'time': time[2],\\n        'position': position[2],\\n        'velocity': velocity[2],\\n        'ke': kinetic_energy[2],\\n        'pe': potential_energy[2],\\n        'te': total_energy[2]\\n    },\\n    {\\n        'time': time[3],\\n        'position': position[3],\\n        'velocity': velocity[3],\\n        'ke': kinetic_energy[3],\\n        'pe': potential_energy[3],\\n        'te': total_energy[3]\\n    },\\n    {\\n        'time': time[4],\\n        'position': position[4],\\n        'velocity': velocity[4],\\n        'ke': kinetic_energy[4],\\n        '"]
