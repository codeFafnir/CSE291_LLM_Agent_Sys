gy,\\n    'final_energy': total_energy[-1],\\n    'max_energy_change_percent': max_energy_change,\\n    'energy_conserving': energy_conserving\\n}\\n\\nfirst_5_steps = [\\n    {\\n        'time': time[0],\\n        'position': position[0],\\n        'velocity': velocity[0],\\n        'ke': kinetic_energy[0],\\n        'pe': potential_energy[0],\\n        'te': total_energy[0]\\n    },\\n    {\\n        'time': time[1],\\n        'position': position[1],\\n        'velocity': velocity[1],\\n        'ke': kinetic_energy[1],\\n        'pe': potential_energy[1],\\n        'te': total_energy[1]\\n    },\\n    {\\n        'time': time[2],\\n        'position': position[2],\\n        'velocity': velocity[2],\\n        'ke': kinetic_energy[2],\\n        'pe': potential_energy[2],\\n        'te': total_energy[2]\\n    },\\n    {\\n        'time': time[3],\\n        'position': position[3],\\n        'velocity': velocity[3],\\n        'ke': kinetic_energy[3],\\n        'pe': potential_energy[3],\\n        'te': total_energy[3]\\n    },\\n    {\\n        'time': time[4],\\n        'position': position[4],\\n        'velocity': velocity[4],\\n        'ke': kinetic_energy[4],\\n        'pe': potential_energy[4],\\n        'te': total_energy[4]\\n    }\\n]\\n\\nlast_5_steps = [\\n    {\\n        'time': time[-5],\\n        'position': position[-5],\\n        'velocity': velocity[-5],\\n        'ke': kinetic_energy[-5],\\n        'pe': potential_energy[-5],\\n        'te': total_energy[-5]\\n    },\\n    {\\n        'time': time[-4],\\n        'position': position[-4],\\n        'velocity': velocity[-4],\\n        'ke': kinetic_energy[-4],\\n        'pe': potential_energy[-4],\\n        'te': total_energy[-4]\\n    },\\n    {\\n        'time': time[-3],\\n        'position': position[-3],\\n        'velocity': velocity[-3],\\n        'ke': kinetic_energy[-3],\\n        'pe': potential_energy[-3],\\n        'te': total_energy[-3]\\n    },\\n    {\\n        'time': time[-2],\\n        'position': position[-2],\\n        'velocity': velocity[-2],\\n        'ke': kinetic_energy[-2],\\n        'pe': potential_energy[-2],\\n        'te': total_energy[-2]\\n    },\\n    {\\n        'time': time[-1],\\n        'position': position[-1],\\n  "]
[189.913974, "i", "      'velocity': velocity[-1],\\n        'ke': kinetic_energy[-1],\\n        'pe': potential_energy[-1],\\n        'te': total_energy[-1]\\n    }\\n]\\n\\nresults = {\\n    'simulation_summary': simulation_summary,\\n    'first_5_steps': first_5_steps,\\n    'last_5_steps': last_5_steps\\n}\\n\\n# Save results to JSON\\nwith open('/app/output/results.json', 'w') as f:\\n    json.dump(results, f, indent=4)\\n\\n# Save trajectory to CSV\\nimport csv\\nwith open('/app/output/trajectory.csv', 'w', newline='') as f:\\n    writer = csv.writer(f)\\n    writer.writerow(['time', 'position', 'velocity', 'kinetic_energy', 'potential_energy', 'total_energy'])\\n    for i in range(total_steps):\\n        writer.writerow([\\n            time[i],\\n            position[i],\\n            velocity[i],\\n            kinetic_energy[i],\\n            potential_energy[i],\\n            total_energy[i]\\n        ])\\n\" > /app/simulation.py\n"]
