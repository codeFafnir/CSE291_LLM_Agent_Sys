[107.512349, "o", "> "]
[107.512423, "o", "    # Determine service status\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.512467, "o", "> "]
[107.512578, "o", "    if not dependencies_met:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.512623, "o", "> "]
[107.512753, "o", "        status = \"dependency_failed\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.512799, "o", "> "]
[107.512911, "o", "    elif not process_running:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.512958, "o", "> "]
[107.513069, "o", "        status = \"unhealthy\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513113, "o", "> "]
[107.513236, "o", "    elif not health_check_passed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513281, "o", "> "]
[107.513385, "o", "        status = \"unhealthy\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513436, "o", "> "]
[107.513479, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513595, "o", "> "]
[107.513685, "o", "        status = \"healthy\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513728, "o", "> "]
[107.513837, "o", "    # Track restart attempts\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.513884, "o", "> "]
[107.51399, "o", "    if status == \"unhealthy\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.514035, "o", "> "]
[107.514176, "o", "        # Log restart and increment counter\r\n\u001b[?2004l\r"]
[107.514218, "o", "\u001b[?2004h> "]
[107.514538, "o", "        log_restart(name, \"process not running\" if not process_running else \"health check failed\")\r\n\u001b[?2004l\r"]
[107.514583, "o", "\u001b[?2004h> "]
[107.514713, "o", "        restart_count[name] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.514784, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.514839, "o", "> "]
[107.514986, "o", "        # Check if max restarts per hour are exceeded\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.515026, "o", "> "]
[107.515187, "o", "        if restart_count[name] > max_restarts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.515227, "o", "> "]
[107.515352, "o", "            status = \"disabled\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.515396, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[107.515481, "o", "> "]
[107.515527, "o", "    # Record service status\r\n\u001b[?2004l\r"]
[107.515613, "o", "\u001b[?2004h> "]
[107.515821, "o", "    service_status[name] = status' >> /app/service_health_monitor.py\r\n\u001b[?2004l\r"]
[107.515973, "o", "\u001b[?2004hroot@107526b08db2:/app# "]
[107.608208, "i", "echo '# Generate health report\nreport = {\n    \"timestamp\": datetime.now().isoformat(),\n    \"services\": {},\n    \"summary\": {\n        \"total_services\": len(services),\n        \"healthy\": 0,\n        \"unhealthy\": 0,\n        \"disabled\": 0,\n        \"dependency_failed\": 0\n    }\n}' >> /app/service_health_monitor.py\n"]
[107.608486, "o", "echo '# Generate health report\r\n\u001b[?2004l\r"]
[107.608539, "o", "\u001b[?2004h> "]
[107.608665, "o", "report = {\r\n\u001b[?2004l\r"]
[107.608712, "o", "\u001b[?2004h> "]
[107.608847, "o", "    \"timestamp\": datetime.now().isoformat(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
