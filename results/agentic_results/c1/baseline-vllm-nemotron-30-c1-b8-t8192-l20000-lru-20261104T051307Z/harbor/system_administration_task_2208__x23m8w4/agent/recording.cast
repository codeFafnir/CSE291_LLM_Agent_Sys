[107.304453, "i", "echo '# Helper function to log restarts\ndef log_restart(service_name, reason):\n    with open(\"/app/restart_log.txt\", \"a\") as f:\n        f.write(f\"[{datetime.now().isoformat()}Z] RESTART: {service_name} (reason: {reason})\\n\")' >> /app/service_health_monitor.py\n"]
