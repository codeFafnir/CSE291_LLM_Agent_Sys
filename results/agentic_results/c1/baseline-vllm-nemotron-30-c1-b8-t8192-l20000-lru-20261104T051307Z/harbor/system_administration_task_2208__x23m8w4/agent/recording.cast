[5.694119, "o", "\u001b[?2004hroot@107526b08db2:/app# "]
[41.536055, "i", "echo \"import json\nimport subprocess\nfrom datetime import datetime, timedelta\nimport os\n\n# Load service configuration\nwith open('/app/services.json') as f:\n    services = json.load(f)\n\n# Initialize restart tracking\ntime_now = datetime.now()\nrestart_count = {service['name']: 0 for service in services}\n\n# Track service statuses\nservice_status = {}\n\n# Helper function to check if a process is running\ndef is_process_running(process_name):\n    try:\n        subprocess.check_output(['pgrep', '-f', process_name])\n        return True\n    except subprocess.CalledProcessError:\n        return False\n\n# Helper function to log restarts\ndef log_restart(service_name, reason):\n    with open('/app/restart_log.txt', 'a') as f:\n        f.write(f\"[{datetime.now().isoformat()}Z] RESTART: {service_name} (reason: {reason})\\n\")\n\n# Helper function to check if all dependencies are healthy\ndef are_dependencies_healthy(service):\n    for dependency in service.get('dependencies', []):\n        if dependency not in service_status or service_status[dependency] != 'healthy':\n            return False\n    return True\n\n# Check each service\nfor service in services:\n    name = service['name']\n    process = service['process']\n    health_check = service.get('health_check')\n    max_restarts = service.get('max_restarts_per_hour', 0)\n\n    # Check dependencies\n    dependencies_met = are_dependencies_healthy(service)\n\n    # Check if the main process is running\n    process_running = is_process_running(process)\n\n    # Execute health check if provided\n    health_check_passed = True\n    if health_check:\n        try:\n            subprocess.check_output(health_check, shell=True)\n        except subprocess.CalledProcessError:\n            health_check_passed = False\n\n    # Determine service status\n    if not dependencies_met:\n        status = 'dependency_failed'\n    elif not process_running:\n        status = 'unhealthy'\n    elif not health_check_passed:\n        status = 'unhealthy'\n    else:\n        status = 'healthy'\n\n    # Track restart attempts\n    if status == 'unhealthy':\n        # Log restart and increment counter\n        log_restart(name, 'process not running' if not process_running else 'health check failed')\n        restart_count[name] += 1\n\n        # Check if max restarts per hour are exceeded\n        if restart_count[name] > max_restarts:\n            status = 'disabled'\n\n    # Record service status\n    service_status[name] = status\n\n# Generate health report\nreport = {\n    'timestamp': datetime.now().isoformat(),\n    'services': {},\n    'summary': {\n        'total_services': len(services),\n        'healthy': 0,\n        'unhealthy': 0,\n        'disabled': 0,\n        'dependency_failed': 0\n    }\n}\n\nfor service in services:\n    name = service['name']\n    status = service_status[name]\n    process_running = is_process_running(service['process'])\n    health_check_passed = True\n    if service.get('health_check'):\n        try:\n            subprocess.check_output(service['health_check'], shell=True)\n        except subprocess.CalledProcessError:\n            health_check_passed = False\n    dependencies_met = are_dependencies_healthy(service)\n\n    # Update service report entry\n    report['services'][name] = {\n        'status': status,\n        'process_running': process_running,\n        'health_check_passed': health_check_passed if service.get('health_check') else 'no_check',\n        'dependencies_met': dependencies_met,\n        'restarts_last_hour': restart_count[name],\n        'last_check': datetime.now().isoformat()\n    }\n\n    # Update summary\n    if status == 'healthy':\n        report['summary']['healthy'] += 1\n    elif status == 'unhealthy':\n        report['summary']['unhealthy'] += 1\n    elif status == 'disabled':\n        report['summary']['disabled'] += 1\n    elif status == 'dependency_failed':\n        report['summary']['dependency_failed'] += 1\n\n# Write health report to file\nwith open('/app/health_report.json', 'w') as f:\n    json.dump(report, f, indent=4)\n\" > /app/service_health_monitor.py\n"]
