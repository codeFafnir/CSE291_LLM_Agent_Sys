[17.402405, "i", "python3 -c \"import sys, json; lines = [l.strip() for l in sys.stdin if l.strip() and not l.startswith('#')]; deps = [{'name': l.split('==')[0], 'version': l.split('==')[1], 'type': 'exact'} if '==' in l else {'name': l.split('>=')[0], 'version': l.split('>=')[1], 'type': 'minimum'} for l in lines]; with open('/app/build_config.json', 'w') as f: json.dump({'project_name': 'calculator', 'language': 'python', 'version': '1.0.0', 'dependencies': deps, 'test_command': 'python -m pytest tests/', 'build_steps': ['pip install -r requirements.txt', 'python -m pytest tests/']}, f, indent=2)\" < /app/requirements.txt\n"]
