[38.166447, "i", "echo \"{\n  \"components\": {\n    \"app_main\": {\n      \"type\": \"executable\",\n      \"dependencies\": [\"network\", \"utils\", \"config\"]\n    },\n    \"network\": {\n      \"type\": \"shared_lib\",\n      \"dependencies\": [\"ssl\", \"logging\"]\n    },\n    \"ssl\": {\n      \"type\": \"static_lib\",\n      \"dependencies\": [\"crypto\"]\n    },\n    \"crypto\": {\n      \"type\": \"static_lib\",\n      \"dependencies\": []\n    },\n    \"logging\": {\n      \"type\": \"header_only\",\n      \"dependencies\": []\n    },\n    \"utils\": {\n      \"type\": \"static_lib\",\n      \"dependencies\": [\"logging\", \"common\"]\n    },\n    \"common\": {\n      \"type\": \"header_only\",\n      \"dependencies\": []\n    },\n    \"config\": {\n      \"type\": \"executable\",\n      \"dependencies\": [\"app_main\"]\n    },\n    \"invalid\": {\n      \"type\": \"static_lib\",\n      \"dependencies\": [\"missing_lib\"]\n    },\n    \"missing_dep\": {\n      \"type\": \"shared_lib\",\n      \"dependencies\": [\"nonexistent\"]\n    },\n    \"circular1\": {\n      \"type\": \"static_lib\",\n      \"dependencies\": [\"circular2\"]\n    },\n    \"circular2\": {\n      \"type\": \"shared_lib\",\n      \"dependencies\": [\"circular1\"]\n    },\n    \"type_violation\": {\n      \"type\": \"executable\",\n      \"dependencies\": [\"config\"]\n    }\n  },\n  \"issues\": {\n    \"circular_dependencies\": [[\"circular1\", \"circular2\", \"circular1\"]],\n    \"missing_dependencies\": [\"missing_lib\", \"nonexistent\"],\n    \"type_violations\": [{\n      \"component\": \"type_violation\",\n      \"dependency\": \"config\",\n      \"rule\": \"executable cannot depend on executable\"\n    }]\n  },\n  \"summary\": {\n    \"total_components\": 13,\n    \"valid_components\": 11,\n    \"total_dependencies\": 12,\n    \"valid_dependencies\": 9\n  }\n}\" > /app/analysis/validation.json\n"]
