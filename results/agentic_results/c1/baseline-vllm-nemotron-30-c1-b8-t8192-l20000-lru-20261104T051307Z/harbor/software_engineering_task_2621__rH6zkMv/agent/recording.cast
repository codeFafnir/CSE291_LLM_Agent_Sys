[39.16794, "i", "echo \"digraph BuildDependencies {\n  rankdir=LR;\n  node [shape=record];\n\n  // Component nodes with type indicator\n  app_main [label=\"{app_main|executable}\", color=blue];\n  network [label=\"{network|shared_lib}\", color=purple];\n  ssl [label=\"{ssl|static_lib}\", color=green];\n  crypto [label=\"{crypto|static_lib}\", color=green];\n  logging [label=\"{logging|header_only}\", color=gray];\n  utils [label=\"{utils|static_lib}\", color=green];\n  common [label=\"{common|header_only}\", color=gray];\n  config [label=\"{config|executable}\", color=blue];\n  invalid [label=\"{invalid|static_lib}\", color=green];\n  missing_dep [label=\"{missing_dep|shared_lib}\", color=purple];\n  circular1 [label=\"{circular1|static_lib}\", color=green];\n  circular2 [label=\"{circular2|shared_lib}\", color=purple];\n  type_violation [label=\"{type_violation|executable}\", color=blue];\n\n  // Valid dependencies as solid arrows\n  app_main -> network;\n  app_main -> utils;\n  app_main -> config;\n  network -> ssl;\n  network -> logging;\n  ssl -> crypto;\n  utils -> logging;\n  utils -> common;\n\n  // Type violation as dashed red arrows\n  type_violation -> config [style=dashed, color=red];\n\n  // Circular dependencies as bold orange arrows\n  circular1 -> circular2 [style=bold, color=orange];\n  circular2 -> circular1 [style=bold, color=orange];\n\n  // Missing dependencies as dotted red arrows with label \"MISSING\"\n  invalid -> missing_lib [style=dotted, color=red, label=\"MISSING\"];\n  missing_dep -> nonexistent [style=dotted, color=red, label=\"MISSING\"];\n}\" > /app/analysis/graph.dot\n"]
