[59.356692, "o", "        # Use condition variable for waiting\r\n\u001b[?2004l\r"]
[59.356773, "o", "\u001b[?2004h> "]
[59.356842, "o", "        with self._condition:\r\n\u001b[?2004l\r"]
[59.356917, "o", "\u001b[?2004h> "]
[59.357086, "o", "            while time.time() - start_time < timeout:\r\n\u001b[?2004l\r"]
[59.357163, "o", "\u001b[?2004h> "]
[59.357244, "o", "                if self._queue:\r\n\u001b[?2004l\r"]
[59.357322, "o", "\u001b[?2004h> "]
[59.357475, "o", "                    message = self._queue.popleft()\r\n\u001b[?2004l\r"]
[59.357545, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.3576, "o", "\u001b[?2004h> "]
[59.357724, "o", "                    # Check for duplicates\r\n\u001b[?2004l\r"]
[59.357773, "o", "\u001b[?2004h> "]
[59.357975, "o", "                    if message.id in self._processed_ids:\r\n\u001b[?2004l\r"]
[59.358026, "o", "\u001b[?2004h> "]
[59.358224, "o", "                        self._stats['duplicate_count'] += 1\r\n\u001b[?2004l\r"]
[59.358309, "o", "\u001b[?2004h> "]
[59.35838, "o", "                        continue\r\n\u001b[?2004l\r"]
[59.358425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.358473, "o", "\u001b[?2004h> "]
[59.358682, "o", "                    self._processed_ids.add(message.id)\r\n\u001b[?2004l\r"]
[59.358756, "o", "\u001b[?2004h> "]
[59.358905, "o", "                    self._stats['dequeue_count'] += 1\r\n\u001b[?2004l\r"]
[59.358982, "o", "\u001b[?2004h> "]
[59.359072, "o", "                    return message\r\n\u001b[?2004l\r"]
[59.359157, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.359208, "o", "\u001b[?2004h> "]
[59.359337, "o", "                # Wait for a short period\r\n\u001b[?2004l\r"]
[59.359413, "o", "\u001b[?2004h> "]
[59.359562, "o", "                self._condition.wait(timeout=0.01)\r\n\u001b[?2004l\r"]
[59.359605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.359718, "o", "\u001b[?2004h> "]
[59.359796, "o", "        self._stats['lost_count'] += 1\r\n\u001b[?2004l\r"]
[59.359841, "o", "\u001b[?2004h> "]
[59.359942, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.36002, "o", "\u001b[?2004h> "]
[59.360089, "o", "    def size(self) -> int:\r\n\u001b[?2004l\r"]
[59.360167, "o", "\u001b[?2004h> "]
[59.360303, "o", "        \"\"\"Return current queue size.\"\"\"\r\n\u001b[?2004l\r"]
[59.360352, "o", "\u001b[?2004h> "]
[59.360455, "o", "        with self._lock:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.360613, "o", "            return len(self._queue)\r\n\u001b[?2004l\r"]
[59.360691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[59.360753, "o", "\u001b[?2004h> "]
[59.360827, "o", "    def get_stats(self) -> dict:\r\n\u001b[?2004l\r"]
[59.360876, "o", "\u001b[?2004h> "]
[59.361017, "o", "        \"\"\"Get queue statistics.\"\"\"\r\n\u001b[?2004l\r"]
[59.361092, "o", "\u001b[?2004h> "]
[59.36115, "o", "        with self._lock:\r\n\u001b[?2004l\r"]
[59.361197, "o", "\u001b[?2004h> "]
[59.361411, "o", "            return self._stats.copy()\"\" > /app/fixed_queue.py\r\n\u001b[?2004l\r"]
[59.361494, "o", "\u001b[?2004h> "]
[59.442879, "i", "python3 /app/reproduction_test.py\n"]
[59.44327, "o", "python3 /app/reproduction_test.py\r\n\u001b[?2004l\r"]
[59.443493, "o", "\u001b[?2004h> "]
