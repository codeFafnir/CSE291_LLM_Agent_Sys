[59.346132, "i", "echo \"import threading\nimport time\nimport random\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom typing import Optional\n\n@dataclass\nclass Message:\n    id: int\n    content: str\n    timestamp: float\n\nclass MessageQueue:\n    \"\"\"Thread-safe message queue with performance fixes.\"\"\"\n\n    def __init__(self, max_size: int = 10000):\n        self._queue = deque()\n        self._max_size = max_size\n        self._lock = threading.Lock()\n        self._condition = threading.Condition(self._lock)\n        self._processed_ids = set()\n        self._stats = {\n            'enqueue_count': 0,\n            'dequeue_count': 0,\n            'duplicate_count': 0,\n            'lost_count': 0\n        }\n\n    def enqueue(self, content: str) -> bool:\n        \"\"\"Add a message to the queue. Returns True if successful.\"\"\"\n        message_id = hash(content)  # Simple ID generation\n\n        # Replace busy-wait loop with condition variable\n        with self._condition:\n            while len(self._queue) >= self._max_size:\n                self._condition.wait()\n\n        with self._lock:\n            # Check for duplicates using a set\n            if message_id in self._processed_ids:\n                self._stats['duplicate_count'] += 1\n                return False\n\n            message = Message(\n                id=message_id,\n                content=content,\n                timestamp=time.time()\n            )\n\n            # Add message to the queue\n            self._queue.append(message)\n            self._stats['enqueue_count'] += 1\n\n            # Notify waiting consumers\n            self._condition.notify()\n\n            return True\n\n    def dequeue(self, timeout: float = 1.0) -> Optional[Message]:\n        \"\"\"Remove and return a message from the queue.\"\"\"\n        start_time = time.time()\n\n        # Use condition variable for waiting\n        with self._condition:\n            while time.time() - start_time < timeout:\n                if self._queue:\n                    message = self._queue.popleft()\n\n                    # Check for duplicates\n                    if message.id in self._processed_ids:\n                        self._stats['duplicate_count'] += 1\n                        continue\n\n                    self._processed_ids.add(message.id)\n                    self._stats['dequeue_count'] += 1\n                    return message\n\n                # Wait for a short period\n                self._condition.wait(timeout=0.01)\n\n        self._stats['lost_count'] += 1\n        return None\n\n    def size(self) -> int:\n        \"\"\"Return current queue size.\"\"\"\n        with self._lock:\n            return len(self._queue)\n\n    def get_stats(self) -> dict:\n        \"\"\"Get queue statistics.\"\"\"\n        with self._lock:\n            return self._stats.copy()\"\" > /app/fixed_queue.py\n"]
