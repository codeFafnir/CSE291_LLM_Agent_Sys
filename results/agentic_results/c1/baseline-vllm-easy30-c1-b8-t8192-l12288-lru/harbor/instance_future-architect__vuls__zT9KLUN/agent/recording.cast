[201.184536, "o", "\tr = r.RemoveRaspbianPackFromResult()\r\n\t\t}\r\n\r\n\t\t// OVAL\r\n\t\tif err := detectPkgsCvesWithOval(ovalCnf, r, logOpts); err != nil {"]
