[42.638535, "i", "cat > Makefile <<'EOF'\nPROJECT_NAME = myproject\nPYTHON = python3\nTEST_DIR = tests/\n\nall: install test lint\n\ninstall:\n    pip install -r requirements.txt\n\nbuild:\n    $(PYTHON) -m py_compile src/*.py\n\nrun:\n    $(PYTHON) src/main.py\n\ntest:\n    pytest $(TEST_DIR)/*.py\n\nlint:\n    black --check src/*.py\n\nclean:\n    rm -f src/*.pyc\n\n.PHONY: all install build run test lint clean\nEOF\n"]
