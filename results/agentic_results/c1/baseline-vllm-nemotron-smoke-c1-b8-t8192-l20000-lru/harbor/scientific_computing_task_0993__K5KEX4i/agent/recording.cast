[144.048172, "i", "cat << EOF > /app/output/script.py\nimport json\nimport sys\nparams = json.load(sys.stdin)\nalpha = params['alpha']\nK = params['K']\ny0 = params['y0']\nt_start = params['t_start']\nt_end = params['t_end']\nnum_steps = params['num_steps']\nh = (t_end - t_start) / num_steps\ny = y0\nt = t_start\nwith open('/app/output/results.csv', 'a') as f:\n    f.write(f\"{t:.4f},{y:.4f}\\n\")\n    for i in range(num_steps):\n        y += h * alpha * y * (1 - y / K)\n        t += h\n        f.write(f\"{t:.4f},{y:.4f}\\n\")\nEOF\n"]
