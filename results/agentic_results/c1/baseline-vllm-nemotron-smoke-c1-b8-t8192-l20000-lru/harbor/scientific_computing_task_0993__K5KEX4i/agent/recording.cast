[160.688527, "i", "awk -F, 'NR==1 {print $1, $2} NR>1 {final_population=$2; if (max_population < $2) max_population=$2; if (abs($2 - K) < 0.01*K && !converged) {converged_time=$1; converged=1}} END {print \"final_population: \" final_population; print \"max_population: \" max_population; print \"convergence_time: \" (converged_time ? converged_time : \"null\")}' K=1000.0 /app/output/results.csv > /app/output/summary.txt\n"]
