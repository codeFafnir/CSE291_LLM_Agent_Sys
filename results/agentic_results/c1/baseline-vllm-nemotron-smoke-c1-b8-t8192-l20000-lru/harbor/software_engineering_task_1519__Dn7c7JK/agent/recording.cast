[15.508377, "o", "\u001b[?2004hroot@3d5caf37b153:/app# "]
[44.524373, "i", "cat > config_validator.py << EOF\nimport sys\nimport os\nimport yaml\nimport json\n\ndef validate_config(config):\n    errors = []\n    if not isinstance(config, dict):\n        errors.append(\"Configuration must be a dictionary.\")\n    else:\n        if not isinstance(config.get('application'), str):\n            errors.append(\"'application' must be a string.\")\n        if not isinstance(config.get('version'), str) or not re.match(r'\\d+\\.\\d+\\.\\d+', config.get('version')):\n            errors.append(\"'version' must be a string in semantic version format (X.Y.Z).\")\n        if not isinstance(config.get('settings'), dict):\n            errors.append(\"'settings' must be a dictionary.\")\n        for key in config:\n            if not isinstance(key, str):\n                errors.append(f\"Key '{key}' must be a string.\")\n    return errors\n\nif __name__ == \"__main__\":\n    input_file = '/app/config.input'\n    output_file = '/app/config.output'\n\n    try:\n        with open(input_file, 'r') as f:\n            content = f.read()\n\n        # Detect format\n        if content.strip().startswith('{'):\n            config = json.loads(content)\n            format = 'json'\n        elif content.strip().startswith('-'):\n            config = yaml.safe_load(content)\n            format = 'yaml'\n        else:\n            # Try to detect based on file extension\n            if input_file.endswith('.json'):\n                config = json.loads(content)\n                format = 'json'\n            elif input_file.endswith('.yaml') or input_file.endswith('.yml'):\n                config = yaml.safe_load(content)\n                format = 'yaml'\n            else:\n                with open(output_file, 'w') as f:\n                    f.write(\"VALIDATION FAILED\\n\")\n                    f.write(\"Errors:\\n\")\n                    f.write(\"- File format could not be determined.\")\n                sys.exit(1)\n\n        # Validate configuration\n        errors = validate_config(config)\n        if errors:\n            with open(output_file, 'w') as f:\n                f.write(\"VALIDATION FAILED\\n\")\n                f.write(\"Errors:\\n\")\n                for error in errors:\n                    f.write(f\"- {error}\\n\")\n            sys.exit(1)\n        else:\n            # Convert and write output\n            if format == 'json':\n                with open(output_file, 'w') as f:\n                    yaml.dump(config, f)\n            elif format == 'yaml':\n                with open(output_file, 'w') as f:\n                    json.dump(config, f)\n            sys.exit(0)\n    except Exception as e:\n        with open(output_file, 'w') as f:\n            f.write(\"VALIDATION FAILED\\n\")\n            f.write(\"Errors:\\n\")\n            f.write(f\"- {str(e)}\\n\")\n        sys.exit(1)\nEOF\n"]
