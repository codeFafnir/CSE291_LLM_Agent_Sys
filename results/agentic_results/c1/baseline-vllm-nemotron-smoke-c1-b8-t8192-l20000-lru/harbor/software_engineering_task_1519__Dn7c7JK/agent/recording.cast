[45.523567, "i", "cat > test_runner.sh << EOF\n#!/bin/bash\n\n# Run the validation script\npython3 /app/config_validator.py\n\n# Check if the output file was created\nif [ -f /app/config.output ]; then\n    echo \"SUCCESS\"\nelse\n    echo \"FAILED\"\nfi\nEOF\n"]
[45.523823, "o", "cat > test_runner.sh << EOF\r\n\u001b[?2004l\r"]
