[360.384741, "o", "\u001b[?2004h> "]
[360.384919, "o", "else ifeq ({config[\"optimization\"]}, release)\r\n\u001b[?2004l\r"]
[360.384981, "o", "\u001b[?2004h> "]
[360.385043, "o", "CXXFLAGS += -O2\r\n\u001b[?2004l\r\u001b[?2004h"]
[360.385096, "o", "> endif\r\n\u001b[?2004l\r"]
