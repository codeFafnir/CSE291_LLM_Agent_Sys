s'][0]}, all)\nCXXFLAGS += -Wall\nelse ifeq ({config['warnings'][0]}, extra)\nCXXFLAGS += -Wextra\nelse ifeq ({config['warnings'][0]}, pedantic)\nCXXFLAGS += -Wpedantic\nendif\n\n# Include directories\nINCLUDE_DIRS = {config['include_dirs']}\n\n# Library directories\nLIB_DIRS = {config['library_dirs']}\n\n# Libraries\nLIBS = {config['libraries']}\n\n# Defines\nDEFINES = {config['defines']}\n\n# Sources and objects\nSOURCES = {config['sources']}\nOBJECTS = $(SOURCES:.cpp=.o)\n\n# Output\nOUTPUT = $(OUTPUT_DIR){config['project_name']}\n\n# Output directory\nOUTPUT_DIR = {config['output_dir']}\n\n# Clean patterns\nCLEAN_PATTERNS = {config['clean_patterns']}\n\n# Default target\nall: $(OUTPUT)\n\n# Pattern rule for compiling .cpp to .o\n$(OUTPUT_DIR)%.o: $(OUTPUT_DIR)%.cpp\n\t$(CC) $(CXXFLAGS) $(DEFINES) -I$(INCLUDE_DIRS) -L$(LIB_DIRS) -o $@ $<\n\n# Linking target\n$(OUTPUT): $(OBJECTS)\n\t$(CC) $(CXXFLAGS) $(DEFINES) -I$(INCLUDE_DIRS) -L$(LIB_DIRS) -o $@ $(OBJECTS) $(LIBS)\n\n# Dependency rules\n-include $(OBJECTS:.o=.d)\n\n# Clean target\nclean:\n\trm -f $(CLEAN_PATTERNS)\n\n# Phony targets\n.PHONY: all clean\n"""\n\nwith open('/app/Makefile', 'w') as f:\n    f.write(makefile_content)\n\n# Write the test program\ntest_program_content = """\n#include <iostream>\n#include "include/math.h"\n\n#define DEBUG 1\n\nint main() {\n    std::cout << "Test program for {config['project_name']}\n";\n    std::cout << "Using define: DEBUG = " << DEBUG << std"\n";\n    std::cout << "Linking with library: m\n";\n    return 0;\n}\n"""\n\nwith open('/app/test_program.cpp', 'w') as f:\n    f.write(test_program_content)\n" > generate_makefile.py
