Sending keys: ['echo \'import json\nimport os\n\n# Read the JSON configuration\nwith open("/app/project_config.json", "r") as f:\n    config = json.load(f)\n\n# Validation checks\nrequired_fields = ["project_name", "target_type", "sources", "headers", "compiler", "standard", "optimization", "include_dirs", "library_dirs", "libraries", "defines", "warnings", "output_dir", "clean_patterns"]\n\nerrors = []\nfor field in required_fields:\n    if field not in config:\n        errors.append(f"Missing required field: {field}")\n\n# Check target_type\nif config["target_type"] not in ["executable", "static_lib", "shared_lib"]:\n    errors.append("Invalid target_type. Must be one of: executable, static_lib, shared_lib")\n\n# Check source files for .cpp extension\nfor source in config["sources"]:\n    if not source.endswith(".cpp"):\n        errors.append(f"Source file {source} does not have a .cpp extension")\n\n# Check if include directories exist\nfor include_dir in config["include_dirs"]:\n    if not os.path.exists(include_dir):\n        errors.append(f"Include directory {include_dir} does not exist")\n\n# Write the generation report\nreport = {\n    "status": "success" if len(errors) == 0 else "failure",\n    "errors": errors,\n    "generated_targets": ["Makefile", "test_program.cpp"],\n    "variables_defined": ["CC", "CXXFLAGS", "LDFLAGS", "SOURCES", "OBJECTS", "OUTPUT", "INCLUDE_DIRS", "LIB_DIRS", "LIBS", "DEFINES", "WARNINGS", "OUTPUT_DIR", "CLEAN_PATTERNS"],\n    "validation_passed": len(errors) == 0\n}\n\nwith open("/app/generation_report.json", "w") as f:\n    json.dump(report, f, indent=4)\n\n# Write the Makefile content\nmakefile_content = """\n# Generated Makefile for {config["project_name"]}\n\nCC = {config["compiler"]}\nCXXFLAGS = -std={config["standard"]}\n\n# Optimization flags\nifeq ({config["optimization"]}, debug)\nCXXFLAGS += -g\nelse ifeq ({config["optimization"]}, release)\nCXXFLAGS += -O2\nendif\n\n# Warning flags\nifeq ({config["warnings"][0]}, all)\nCXXFLAGS += -Wall\nelse ifeq ({config["warnings"][0]}, extra)\nCXXFLAGS += -Wextra\nelse ifeq ({config["warnings"][0]}, pedantic)\nCXXFLAGS += -Wpedantic\nendif\n\n# Include directories\nINCLUDE_DIRS = {config["include_dirs"]}\n\n# Library directories\nLIB_DIRS = {config["library_dirs"]}\n\n# Libraries\nLIBS = {config["libraries"]}\n\n# Defines\nDEFINES = {config["defines"]}\n\n# Sources and objects\nSOURCES = {config["sources"]}\nOBJECTS = $(SOURCES:.cpp=.o)\n\n# Output\nOUTPUT = $(OUTPUT_DIR){config["project_name"]}\n\n# Output directory\nOUTPUT_DIR = {config["output_dir"]}\n\n# Clean patterns\nCLEAN_PATTERNS = {config["clean_patterns"]}\n\n# Default target\nall: $(OUTPUT)\n\n# Pattern rule for compiling .cpp to .o\n$(OUTPUT_DIR)%.o: $(OUTPUT_DIR)%.cpp\n\t$(CC) $(CXXFLAGS) $(DEFINES) -I$(INCLUDE_DIRS) -L$(LIB_DIRS) -o $@ $<\n\n# Linking target\n$(OUTPUT): $(OBJECTS)\n\t$(CC) $(CXXFLAGS) $(DEFINES) -I$(INCLUDE_DIRS) -L$(LIB_DIRS) -o $@ $(OBJECTS) $(LIBS)\n\n# Dependency rules\n-include $(OBJECTS:.o=.d)\n\n# Clean target\nclean:\n\trm -f $(CLEAN_PATTERNS)\n\n# Phony targets\n.PHONY: all clean\n"""\n\nwith open("/app/Makefile", "w") as f:\n    f.write(makefile_content)\n\n# Write the test program\ntest_program_content = """\n#include <iostream>\n#include "include/math.h"\n\n#define DEBUG 1\n\nint main() {\n    std::cout << "Test program for {config["project_name"]}\\n";\n    std::cout << "Using define: DEBUG = " << DEBUG << std"\\n";\n    std::cout << "Linking with library: m\\n";\n    return 0;\n}\n"""\n\nwith open("/app/test_program.cpp", "w") as f:\n    f.write(test_program_content)\n" > generate_makefile.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
